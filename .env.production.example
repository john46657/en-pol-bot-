# NEXUS – Produktion. Kopieren nach .env.production (nie committen) und ausfüllen.
# Alle mit CHANGE_ME markierten Werte MÜSSEN gesetzt werden; die API startet in Produktion sonst nicht (Konfigurationsprüfung).

NODE_ENV=production

# Datenbank-Passwort (DATABASE_URL/REDIS_URL setzt docker-compose.prod.yml selbst zusammen)
POSTGRES_PASSWORD=CHANGE_ME_langes_zufaelliges_passwort

# Öffentliche Adressen (https!)
API_URL=https://api.example.org
DASHBOARD_URL=https://dashboard.example.org
AUTH_CALLBACK_URL=https://api.example.org/api/v1/auth/discord/callback
# Hinter einem Reverse-Proxy: Anzahl vertrauenswürdiger Proxys (für Rate Limits je Client-IP)
TRUST_PROXY=1

# Discord (Developer Portal)
DISCORD_TOKEN=CHANGE_ME
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME

# Sitzungen: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_mindestens_32_zeichen
JWT_ISSUER=nexus

QUEUE_PREFIX=nexus
LOG_LEVEL=info
