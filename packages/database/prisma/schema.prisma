// NEXUS – Prisma Schema: Applications-Modul (§63)
//
// Alle Tabellen sind Guild-scoped. Jede Query muss den Guild Context
// berücksichtigen (§113): getById(guildId, id) – niemals getById(id).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum SubmissionStatus {
  STARTED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  DENIED
  EXPIRED
  CANCELLED
  WITHDRAWN
  ARCHIVED
}

enum QuestionType {
  TEXT
  LONG_TEXT
  NUMBER
  DECIMAL
  DATE
  TIME
  DATETIME
  YES_NO
  SINGLE_SELECT
  MULTI_SELECT
  RATING
  SLIDER
  DISCORD_USER
  DISCORD_ROLE
  DISCORD_CHANNEL
  URL
  EMAIL
  PHONE
  USERNAME
  CONFIRMATION
  CHECKBOX
  MULTI_CHECKBOX
  FILE
  IMAGE
  ATTACHMENT
  PARAGRAPH
  INFO
  SEPARATOR
}

enum ConditionOperator {
  equals
  not_equals
  contains
  not_contains
  starts_with
  ends_with
  greater_than
  less_than
  greater_or_equal
  less_or_equal
  is_empty
  is_not_empty
  in
  not_in
}

enum ConditionCombinator {
  AND
  OR
  NOT
}

enum RoleMatchMode {
  HAS_ALL
  HAS_ANY
  HAS_NONE
}

enum RoleRuleType {
  REQUIRED
  RESTRICTED
  ACCEPTED
  DENIED
  PENDING
  PING
  ACCEPTED_REMOVAL
  DENIED_REMOVAL
  SUBMIT_REMOVAL
}

enum ResubmissionMode {
  NEVER
  AFTER_DENIAL
  AFTER_COOLDOWN
  AFTER_STAFF_APPROVAL
  ALWAYS
}

enum UserLeaveAction {
  NOTHING
  CANCEL
  ARCHIVE
  DELETE
  MARK_AS_LEFT
  DENY
}

enum ExportFormat {
  CSV
  JSON
  XLSX
  PDF
}

enum ExportStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum ReviewerAssignmentType {
  USER
  ROLE
}

enum DMPhase {
  INTRO
  QUESTION
  SUMMARY
  EDITING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum AttachmentStatus {
  PENDING
  VERIFIED
  REJECTED
  MIRRORED
}

enum IntegrationType {
  WEBHOOK
  DISCORD_WEBHOOK
  NOTION
  GOOGLE_SHEETS
  REST_API
  ZAPIER
  MAKE
}

/// Zustand eines Teammitglieds (Spezifikation: ACTIVE, PAUSE, OFF_DUTY, SUSPENDED; „CLOSED“ = Akte archiviert).
enum TeamState {
  ACTIVE
  PAUSE
  OFF_DUTY
  SUSPENDED
}

enum PersonnelStatus {
  ACTIVE
  ARCHIVED
}

enum ShiftStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum UnitStatus {
  AVAILABLE
  BUSY
  BREAK
  UNAVAILABLE
}

enum UnitRole {
  LEADER
  MEMBER
}

enum RadioLevel {
  LISTEN
  SPEAK
  FULL
}

enum RadioArea {
  GENERAL
  SPECIAL
}

enum OperationStatus {
  REQUESTED
  EN_ROUTE
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OperationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WantedKind {
  PERSON
  VEHICLE
}

enum WantedStatus {
  ACTIVE
  /// Aufgehoben (entspricht „CANCELLED“ der Spezifikation).
  REVOKED
  /// Automatisch abgelaufen.
  EXPIRED
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum DamageSeverity {
  MINOR
  MAJOR
  TOTAL
}

enum PenaltyKind {
  FINE
  WARNING
  POINTS
  LICENSE_REVOCATION
  VEHICLE_SEIZURE
}

enum PenaltyStatus {
  ACTIVE
  REVOKED
}

enum TrainingStatus {
  PLANNED
  RUNNING
  FINISHED
  CANCELLED
}

enum ParticipantStatus {
  ENROLLED
  PASSED
  FAILED
  WITHDRAWN
  REMOVED
}

enum PromotionStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum TicketStatus {
  OPEN
  /// In Bearbeitung (Ticket übernommen).
  IN_PROGRESS
  /// Wartet auf Rückmeldung des Erstellers.
  WAITING
  CLOSED
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  ENDED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum PermissionScope {
  SERVER
  TEAM
  RECORD
}

enum AuditActorType {
  USER
  SYSTEM
  BOT
  AUTOMATION
}

// ---------------------------------------------------------------------------
// Guild
// ---------------------------------------------------------------------------

/// Ein Discord-Server. Höchste Isolationsebene: alle Daten hängen daran (§113).
/// Dashboard-Design je Server (Phase 37): aktives Theme + serverweite Einzel-Überschreibungen.
model DashboardSettings {
  guildId       String   @id
  activeThemeId String?
  /// Teilkonfiguration, die über dem Theme liegt (Custom > Theme > Standard)
  overrides     Json     @default("{}")
  /// Zuletzt fehlerfrei geladene, vollständige Konfiguration (Fallback)
  lastGood      Json?
  autosave      Boolean  @default(false)
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("dashboard_settings")
}

model DashboardTheme {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String   @default("")
  /// Aktuelle Versionsnummer (siehe DashboardThemeVersion)
  version     Int      @default(1)
  config      Json
  /// Mitgelieferte Vorlage (Standard, Midnight, …) – nicht löschbar
  builtin     Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild    Guild                   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  versions DashboardThemeVersion[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("dashboard_themes")
}

/// Hochgeladenes Bild für das Dashboard-Design (Logo, Hintergrund, Widget-Bilder). Datei liegt im Speicherordner.
model DashboardAsset {
  id           String   @id
  guildId      String
  /// Dateiname im Speicher (zufällige ID + Endung)
  file         String
  mime         String
  bytes        Int
  width        Int
  height       Int
  /// Ursprünglicher Dateiname (nur zur Anzeige, bereinigt)
  originalName String
  createdBy    String?
  createdAt    DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@map("dashboard_assets")
}

model DashboardThemeVersion {
  id            String   @id @default(cuid())
  themeId       String
  version       Int
  config        Json
  changeSummary String
  createdBy     String?
  createdAt     DateTime @default(now())

  theme DashboardTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, version])
  @@map("dashboard_theme_versions")
}

model Guild {
  id        String   @id /// Discord Guild ID (Snowflake)
  name      String
  iconUrl   String?
  ownerId   String?
  features  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bot hat den Server verlassen (Daten bleiben erhalten); null = Bot ist auf dem Server.
  leftAt DateTime?

  settings           GuildSettings?
  roles              DiscordRole[]
  channels           DiscordChannel[]
  permissions        Permission[]
  auditLogs          AuditLog[]
  messagePanels      Panel[]
  permissionProfiles PermissionProfile[]
  userPermissions    UserPermission[]
  ranks              Rank[]
  teams              Team[]
  personnelRecords   PersonnelRecord[]
  shiftTypes         ShiftType[]
  shifts             Shift[]
  units              Unit[]
  radioChannels      RadioChannel[]
  radioAccess        RadioAccess[]
  operations         Operation[]
  dangerLevels       DangerLevel[]
  wantedNotices      WantedNotice[]
  vehicles           Vehicle[]
  penalties          Penalty[]
  trainingCourses    TrainingCourse[]
  trainings          Training[]
  qualifications     Qualification[]
  promotionRules     PromotionRule[]
  promotions         PromotionRequest[]
  sekSquads          SekSquad[]
  ticketCategories   TicketCategory[]
  ticketSettings     TicketSettings?
  tickets            Ticket[]
  absences           Absence[]
  reports            Report[]
  notifications      Notification[]
  statSnapshots      StatSnapshot[]
  dashboardSettings  DashboardSettings?
  dashboardThemes    DashboardTheme[]
  dashboardAssets    DashboardAsset[]

  applications      Application[]
  panels            ApplicationPanel[]
  submissions       ApplicationSubmission[]
  cooldowns         ApplicationCooldown[]
  templates         ApplicationTemplate[]
  questionTemplates QuestionTemplate[]
  exports           ApplicationExport[]
  automations       ApplicationAutomation[]

  @@map("guilds")
  restrictions Restriction[]
  applicationNumberCounters ApplicationNumberCounter[]
}

// ---------------------------------------------------------------------------
// Application + Versioning (§4/§65)
// ---------------------------------------------------------------------------

/// Eine Bewerbung (Polizei, Medic, Whitelist, …) – use-case-agnostic (§3).
model Application {
  id          String            @id @default(cuid())
  guildId     String
  name        String
  slug        String
  description String?
  icon        String?
  image       String?
  color       String?
  /// Präfix der Bewerbungs-ID (z. B. POL → POL-00152); ohne Angabe SUB.
  idPrefix    String?
  enabled     Boolean           @default(true)
  status      ApplicationStatus @default(DRAFT)
  /// Konfiguration: requirements, messages, embed, stats, review, advanced (§69/§70-75).
  config      Json
  createdBy   String
  updatedBy   String
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  guild        Guild                         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  versions     ApplicationVersion[]
  questions    ApplicationQuestion[]
  cooldowns    ApplicationCooldown[]
  panels       ApplicationPanelApplication[]
  submissions  ApplicationSubmission[]
  roleRules    ApplicationRoleRule[]
  automations  ApplicationAutomation[]
  integrations ApplicationIntegration[]
  analytics    ApplicationAnalyticsDaily[]

  @@unique([guildId, slug])
  @@index([guildId, status])
  @@index([guildId, updatedAt])
  @@map("applications")
}

/// Versionierung (§65): Submissions referenzieren immer ihre Version.
model ApplicationVersion {
  id            String   @id @default(cuid())
  applicationId String
  version       Int      @default(1)
  /// Vollständiger Snapshot aller Fragen + Conditions zum Veröffentlichungszeitpunkt.
  questions     Json
  changelog     String?
  publishedAt   DateTime @default(now())
  publishedById String

  application Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  submissions ApplicationSubmission[]

  @@unique([applicationId, version])
  @@map("application_versions")
}

/// Aktuelle Fragen der unveröffentlichten Version (relational, für den Builder).
model ApplicationQuestion {
  id            String                      @id @default(cuid())
  applicationId String
  questionId    String /// stabile ID innerhalb der Application
  type          QuestionType
  title         String
  description   String?
  required      Boolean                     @default(false)
  placeholder   String?
  defaultValue  String?
  validation    Json?
  options       ApplicationQuestionOption[]
  conditions    ApplicationCondition[]
  order         Int
  metadata      Json?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([applicationId, order])
  @@map("application_questions")
}

model ApplicationQuestionOption {
  id          String  @id @default(cuid())
  questionId  String
  label       String
  value       String
  description String?
  emoji       String?
  enabled     Boolean @default(true)
  order       Int

  question ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("application_question_options")
}

/// Bedingung für die Sichtbarkeit einer Frage (§13).
model ApplicationCondition {
  id         String @id @default(cuid())
  questionId String
  /// Verschachtelte Condition als JSON (AND/OR/NOT, Blätter + Gruppen).
  node       Json
  order      Int

  question ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("application_conditions")
}

// ---------------------------------------------------------------------------
// Panels (§40/§41/§42)
// ---------------------------------------------------------------------------

/// Bewerbungs-Panel im Discord (eine Nachricht, mehrere Applications möglich).
model ApplicationPanel {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  title       String
  description String?
  embed       Json
  layout      String   @default("button") /// button | select | button_and_select
  buttonLabel String?
  buttonEmoji String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild        Guild                         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  applications ApplicationPanelApplication[]

  @@index([guildId, channelId])
  @@map("application_panels")
}

/// n:m Panel ↔ Application
model ApplicationPanelApplication {
  panelId       String
  applicationId String
  order         Int

  panel       ApplicationPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([panelId, applicationId])
  @@map("application_panel_applications")
}

// ---------------------------------------------------------------------------
// Submissions (§25/§62)
// ---------------------------------------------------------------------------

/// Eine konkrete Bewerbung eines Users.
model ApplicationSubmission {
  id                  String           @id @default(cuid())
  guildId             String
  applicationId       String
  versionId           String
  /// Menschenlesbare ID, z. B. POL-00152 (wird beim Einreichen vergeben)
  submissionNumber    String?
  userId              String
  /// Snapshot (§25) – historisch nachvollziehbar
  usernameSnapshot    String
  displayNameSnapshot String
  avatarSnapshot      String?
  status              SubmissionStatus @default(STARTED)
  isTest              Boolean          @default(false) /// TEST-Markierung (§118)
  startedAt           DateTime         @default(now())
  submittedAt         DateTime?
  durationSeconds     Int?
  reviewerUserId      String?
  /// Bearbeiter, der die Bewerbung übernommen hat (nicht dasselbe wie der Entscheider `reviewerUserId`).
  assigneeUserId      String?
  assignedAt          DateTime?
  acceptedAt          DateTime?
  deniedAt            DateTime?
  publicReason        String?
  internalReason      String?
  submissionMessageId String?
  submissionChannelId String?
  threadId            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  guild       Guild                   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  application Application             @relation(fields: [applicationId], references: [id])
  version     ApplicationVersion      @relation(fields: [versionId], references: [id])
  answers     ApplicationAnswer[]
  attachments ApplicationAttachment[]
  notes       ApplicationNote[]
  auditEvents ApplicationAuditEvent[]
  reviewers   ApplicationReviewer[]
  dmState     ApplicationDMState?

  @@unique([guildId, submissionNumber])
  @@index([guildId, status])
  @@index([guildId, userId, status])
  @@index([guildId, applicationId, status])
  @@index([guildId, reviewerUserId])
  @@map("application_submissions")
}

/// Einzelne Antwort (§64: nicht nur Blob, sondern strukturiert pro Frage).
model ApplicationAnswer {
  id                String   @id @default(cuid())
  submissionId      String
  questionId        String /// stabile Frage-ID
  questionVersionId String /// Version-Snapshot (§156)
  value             Json
  normalizedValue   String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  submission ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([normalizedValue])
  @@map("application_answers")
}

/// DM-Sitzungszustand (§94: Recovery nach Bot-Restart)
model ApplicationDMState {
  submissionId       String    @id
  userId             String
  guildId            String
  phase              DMPhase   @default(INTRO)
  currentQuestionId  String?
  currentDMMessageId String?
  introMessageId     String?
  lastInteractionAt  DateTime  @default(now())
  expiresAt          DateTime?

  submission ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("application_dm_states")
}

/// Reviewer-Zuweisungen (§36: User/Role, Round-Robin, Workload)
model ApplicationReviewer {
  id           String                 @id @default(cuid())
  submissionId String
  assigneeType ReviewerAssignmentType
  assigneeId   String
  assignedById String
  assignedAt   DateTime               @default(now())

  submission ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([assigneeId])
  @@map("application_reviewers")
}

/// Interne Notizen (§35: nicht für Bewerber, Änderungen protokolliert)
model ApplicationNote {
  id           String   @id @default(cuid())
  submissionId String
  authorId     String
  content      String
  mentions     String[]
  edits        Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("application_notes")
}

/// Audit-Events (§34/§89: unveränderbar – kein updateAt!)
model ApplicationAuditEvent {
  id            String         @id @default(cuid())
  guildId       String
  submissionId  String?
  applicationId String?
  actorType     AuditActorType
  actorId       String?
  action        String
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime       @default(now())

  submission ApplicationSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([submissionId, createdAt])
  @@index([action])
  @@map("application_audit_events")
}

/// Cooldown je User/Application (§51)
model ApplicationCooldown {
  id            String   @id @default(cuid())
  guildId       String
  applicationId String
  userId        String
  reason        String /// DENIED | CANCELLED | SUBMITTED | EXPIRED
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  guild       Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([guildId, applicationId, userId, reason])
  @@index([userId])
  @@map("application_cooldowns")
}

/// Attachments (§50)
model ApplicationAttachment {
  id           String           @id @default(cuid())
  submissionId String
  questionId   String
  attachmentId String
  filename     String
  mimeType     String?
  sizeBytes    BigInt
  url          String
  s3Key        String?
  status       AttachmentStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  submission ApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("application_attachments")
}

// ---------------------------------------------------------------------------
// Rollen & Automation (§38/§39/§57)
// ---------------------------------------------------------------------------

/// Rollenregeln einer Application (§38)
model ApplicationRoleRule {
  id                String        @id @default(cuid())
  applicationId     String
  type              RoleRuleType
  roleId            String
  matchMode         RoleMatchMode @default(HAS_ALL)
  additionalRoleIds String[]

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, type])
  @@map("application_role_rules")
}

/// Automationen (§57/§58)
model ApplicationAutomation {
  id            String    @id @default(cuid())
  guildId       String
  applicationId String?
  enabled       Boolean   @default(true)
  trigger       String /// application.submitted, …
  condition     Json?
  actions       Json
  lastRunAt     DateTime?
  lastRunStatus String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  guild       Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([guildId, trigger])
  @@map("application_automations")
}

/// Integrationen (§103: Secrets verschlüsselt, niemals loggen)
model ApplicationIntegration {
  id            String          @id @default(cuid())
  applicationId String
  type          IntegrationType
  name          String
  /// Verschlüsselter Secret-Blob (verschlüsselt mit INTEGRATION_ENCRYPTION_KEY).
  secret        Bytes?
  config        Json
  enabled       Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_integrations")
}

// ---------------------------------------------------------------------------
// Templates (§43/§44/§100)
// ---------------------------------------------------------------------------

/// Application-Templates (§43)
model ApplicationTemplate {
  id          String   @id @default(cuid())
  guildId     String? /// null = system-weit, gesetzt = guild-intern (§100)
  name        String
  description String?
  icon        String?
  category    String?
  structure   Json /// questions, conditions, roleRules, messages
  isPublic    Boolean  @default(false)
  version     Int      @default(1)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, isPublic])
  @@map("application_templates")
}

/// Wiederverwendbare Fragen (§44)
model QuestionTemplate {
  id          String       @id @default(cuid())
  guildId     String?
  title       String
  type        QuestionType
  description String?
  validation  Json?
  options     Json?
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("question_templates")
}

// ---------------------------------------------------------------------------
// Export & Analytics (§66/§45)
// ---------------------------------------------------------------------------

/// Export-Jobs (§66/§122: Permission + ablaufende signierte URL + Audit)
model ApplicationExport {
  id            String       @id @default(cuid())
  guildId       String
  requestedById String
  format        ExportFormat
  status        ExportStatus @default(PENDING)
  filters       Json
  rowCount      Int?
  fileUrl       String? /// signierte, ablaufende URL
  expiresAt     DateTime?
  error         String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@map("application_exports")
}

/// Tägliche Analytics-Aggregation (§45)
model ApplicationAnalyticsDaily {
  id                 String   @id @default(cuid())
  applicationId      String
  day                DateTime @db.Date
  started            Int      @default(0)
  submitted          Int      @default(0)
  accepted           Int      @default(0)
  denied             Int      @default(0)
  expired            Int      @default(0)
  cancelled          Int      @default(0)
  avgDurationSeconds Int?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, day])
  @@map("application_analytics_daily")
}

// ---------------------------------------------------------------------------
// Phase 1: Grundmodelle (Einstellungen, Benutzer, Rollen, Kanäle, Permissions, Audit)
// ---------------------------------------------------------------------------

/// Servereinstellungen (1:1 zur Guild). `data` nimmt modulspezifische Werte auf.
model GuildSettings {
  guildId      String   @id
  locale       String   @default("de")
  timezone     String   @default("Europe/Berlin")
  /// Kanal für Bot-/Audit-Meldungen (Discord-Kanal-ID).
  logChannelId String?
  data         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("guild_settings")
}

/// Discord-Benutzer (global, nicht guild-scoped). `id` = Discord-User-ID.
model User {
  id         String    @id
  username   String
  globalName String?
  avatarUrl  String?
  bot        Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  @@map("users")
}

/// Gespiegelte Discord-Rolle. `discordId` ist nur je Guild eindeutig.
model DiscordRole {
  id          String    @id @default(cuid())
  guildId     String
  discordId   String
  name        String
  color       Int       @default(0)
  position    Int       @default(0)
  /// Discord-Permission-Bitfeld als Dezimalstring (BigInt-sicher).
  permissions String    @default("0")
  managed     Boolean   @default(false)
  mentionable Boolean   @default(false)
  hoist       Boolean   @default(false)
  /// Auf Discord gelöscht (Soft Delete, damit Permission-Zuordnungen nachvollziehbar bleiben).
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  guild    Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  grants   Permission[]
  profiles RoleProfile[]

  @@unique([guildId, discordId])
  @@index([guildId, position])
  @@map("discord_roles")
}

/// Gespiegelter Discord-Kanal (Text, Voice, Kategorie, …). `type` = Discord ChannelType.
model DiscordChannel {
  id        String    @id @default(cuid())
  guildId   String
  discordId String
  name      String
  type      Int
  parentId  String?
  position  Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordId])
  @@index([guildId, type])
  @@map("discord_channels")
}

/// Zuordnung Permission-Key (z. B. "applications.manage") → Discord-Rolle.
model Permission {
  id        String           @id @default(cuid())
  guildId   String
  key       String
  roleId    String
  /// ALLOW erlaubt, DENY sperrt ausdrücklich (Sperre schlägt Erlaubnis).
  effect    PermissionEffect @default(ALLOW)
  scope     PermissionScope  @default(SERVER)
  /// Team-/Datensatz-ID bei expliziter Einschränkung; leer = n/a bzw. „eigenes Team“.
  scopeRef  String           @default("")
  createdAt DateTime         @default(now())

  guild Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  role  DiscordRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([guildId, key, roleId, effect, scope, scopeRef])
  @@index([guildId, key])
  @@map("permissions")
}

/// Berechtigungsprofil: benannte Menge von Erlaubnissen/Sperren, die Discord-Rollen zugeordnet wird.
model PermissionProfile {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  /// [{ key, effect, scope, scopeRef? }]
  entries     Json
  /// Vorlage, aus der das Profil erzeugt wurde (nur Herkunft, keine Kopplung).
  templateKey String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  roles RoleProfile[]

  @@unique([guildId, name])
  @@map("permission_profiles")
}

/// Zuordnung Discord-Rolle ↔ Profil.
model RoleProfile {
  id        String   @id @default(cuid())
  guildId   String
  roleId    String
  profileId String
  createdAt DateTime @default(now())

  role    DiscordRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  profile PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([roleId, profileId])
  @@index([guildId])
  @@map("role_profiles")
}

/// Benutzerbezogene Ausnahme (Erlaubnis oder Sperre) – höchste Spezifität.
model UserPermission {
  id        String           @id @default(cuid())
  guildId   String
  userId    String
  key       String
  effect    PermissionEffect
  scope     PermissionScope  @default(SERVER)
  scopeRef  String           @default("")
  note      String?
  createdBy String?
  createdAt DateTime         @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, key, effect, scope, scopeRef])
  @@index([guildId, userId])
  @@map("user_permissions")
}

/// Allgemeines, nur anhängbares Audit-Log (Bewerbungen haben zusätzlich ApplicationAuditEvent).
model AuditLog {
  id           String         @id @default(cuid())
  guildId      String
  actorType    AuditActorType
  actorId      String?
  action       String
  resourceType String?
  resourceId   String?
  before       Json?
  after        Json?
  metadata     Json?
  /// Ergebnis der Aktion: success | partial | failed (null = nicht zutreffend).
  result       String?
  /// Verwendete Berechtigung (Schlüssel).
  permission   String?
  /// Auslösende Automation (Name/ID).
  automation   String?
  /// Begründung bzw. Fehlergrund.
  reason       String?
  createdAt    DateTime       @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, action])
  @@index([guildId, resourceType, resourceId])
  @@map("audit_logs")
}

/// Universelles Panel: Discord-Nachricht aus Embed + Buttons + Select-Menü. `config` = PanelConfig (@nexus/types).
model Panel {
  id         String    @id @default(cuid())
  guildId    String
  name       String
  config     Json
  /// Kanal/Nachricht des zuletzt gesendeten Panels (null = noch nie gesendet).
  channelId  String?
  messageId  String?
  lastSentAt DateTime?
  /// Gesendete Nachricht bei jeder Änderung automatisch aktualisieren.
  autoUpdate Boolean   @default(true)
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("panels")
}

// ---------------------------------------------------------------------------
// Phase 11: Personalakten
// ---------------------------------------------------------------------------

/// Dienstgrad. `order` bestimmt die Hierarchie (größer = höher).
model Rank {
  id            String   @id @default(cuid())
  guildId       String
  name          String
  shortName     String?
  order         Int
  /// Einstiegsdienstgrad für neu angenommene Mitarbeiter.
  isEntry       Boolean  @default(false)
  /// Optionale Discord-Rolle, die mit dem Dienstgrad verbunden ist.
  discordRoleId String?
  /// Anzeige: Symbol (Emoji) und Farbe (#RRGGBB).
  icon          String?
  color         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild   Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  records PersonnelRecord[]

  @@unique([guildId, name])
  @@index([guildId, order])
  @@map("ranks")
}

/// Team/Abteilung. Grundlage für den TEAM-Geltungsbereich der Berechtigungen.
model Team {
  id            String   @id @default(cuid())
  guildId       String
  name          String
  description   String?
  /// Optionale Discord-Teamrolle.
  discordRoleId String?
  /// Teamleitung (Discord-User-ID): gilt für den TEAM-Bereich als „eigenes Team“.
  leaderUserId  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild   Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  records PersonnelRecord[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("teams")
}

/// Zentrale Personalakte. Alle späteren Module (Ausbildung, Beförderung, Shifts, Abwesenheit …) hängen hier an.
model PersonnelRecord {
  id                 String          @id @default(cuid())
  guildId            String
  /// Discord-User-ID (je Server höchstens eine Akte).
  userId             String
  rpName             String
  serviceNumber      String?
  rankId             String?
  teamId             String?
  status             PersonnelStatus @default(ACTIVE)
  joinedAt           DateTime        @default(now())
  probationEndsAt    DateTime?
  archivedAt         DateTime?
  archivedReason     String?
  archivedBy         String?
  teamState          TeamState       @default(ACTIVE)
  teamStateReason    String?
  teamStateAt        DateTime?
  teamStateBy        String?
  /// Bewerbung, aus der die Akte entstand (nur Herkunft).
  sourceSubmissionId String?
  createdBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  guild   Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  rank    Rank?            @relation(fields: [rankId], references: [id], onDelete: SetNull)
  team    Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  entries PersonnelEntry[]
  events  PersonnelEvent[]

  @@unique([guildId, userId])
  @@unique([guildId, serviceNumber])
  @@index([guildId, status])
  @@index([guildId, teamId])
  @@map("personnel_records")
}

/// Eintrag in der Akte. `kind` ist erweiterbar: AWARD, DISCIPLINE, NOTE (Phase 11) sowie später TRAINING,
/// QUALIFICATION, PROMOTION, ABSENCE, SHIFT, OPERATION … durch die jeweiligen Module.
model PersonnelEntry {
  id           String    @id @default(cuid())
  guildId      String
  recordId     String
  kind         String
  title        String
  body         String?
  data         Json?
  occurredAt   DateTime  @default(now())
  createdBy    String?
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  createdAt    DateTime  @default(now())

  record PersonnelRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, kind])
  @@index([guildId, kind])
  @@map("personnel_entries")
}

/// Verlauf der Akte (wer hat wann was geändert).
model PersonnelEvent {
  id        String   @id @default(cuid())
  guildId   String
  recordId  String
  type      String
  actorId   String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  record PersonnelRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt])
  @@map("personnel_events")
}

// ---------------------------------------------------------------------------
// Phase 12: Shifts
// ---------------------------------------------------------------------------

/// Shift-Typ (Streife, SEK, Ausbildung, Führung …) mit konfigurierbarer Rollenanforderung.
model ShiftType {
  id                 String   @id @default(cuid())
  guildId            String
  name               String
  description        String?
  emoji              String?
  /// Mindestens eine dieser Discord-Rollen ist nötig (leer = keine Anforderung).
  requiredRoleIds    String[]
  /// Schichten, die länger laufen, gelten als ungewöhnlich lang (Benachrichtigung).
  maxDurationMinutes Int      @default(480)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  guild  Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  shifts Shift[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("shift_types")
}

/// Eine Schicht. `openKey` = 'open' solange sie läuft (NULL danach): die Unique-Bedingung erlaubt je Mitglied und
/// Server höchstens eine offene Schicht – auch bei gleichzeitigen Starts.
model Shift {
  id              String      @id @default(cuid())
  guildId         String
  userId          String
  typeId          String
  /// Verknüpfte Personalakte (falls vorhanden).
  recordId        String?
  status          ShiftStatus @default(ACTIVE)
  openKey         String?
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  /// Beginn der aktuellen Pause (nur im Status PAUSED).
  pausedAt        DateTime?
  /// Summe aller beendeten Pausen in Sekunden.
  pausedSeconds   Int         @default(0)
  /// Nettodauer in Sekunden (nur beendete Schichten).
  durationSeconds Int?
  endedBy         String?
  /// manual | supervisor | corrected
  endReason       String?
  /// Wann die Benachrichtigung „ungewöhnlich lang“ gesendet wurde.
  flaggedLongAt   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  guild  Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type   ShiftType    @relation(fields: [typeId], references: [id])
  events ShiftEvent[]

  @@unique([guildId, userId, openKey])
  @@index([guildId, userId, startedAt])
  @@index([guildId, status])
  @@index([guildId, typeId, startedAt])
  @@map("shifts")
}

/// Rohdaten: jedes Ereignis einer Schicht (start, pause, resume, end, correct, flag …).
model ShiftEvent {
  id      String   @id @default(cuid())
  guildId String
  shiftId String
  type    String
  at      DateTime @default(now())
  actorId String?
  data    Json?

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, at])
  @@map("shift_events")
}

// ---------------------------------------------------------------------------
// Phase 14: Dienst & Streifen
// ---------------------------------------------------------------------------

/// Einheit/Streife. `activeKey` = 'active' solange sie besteht (NULL nach Auflösung): Rufname je Server nur einmal aktiv.
model Unit {
  id          String     @id @default(cuid())
  guildId     String
  callsign    String
  kind        String     @default("Streife")
  status      UnitStatus @default(AVAILABLE)
  statusSince DateTime   @default(now())
  vehicle     String?
  /// Aktueller Standort (optional, Freitext).
  location    String?
  note        String?
  activeKey   String?
  createdBy   String
  disbandedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  guild   Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  members UnitMember[]
  events  UnitEvent[]

  @@unique([guildId, callsign, activeKey])
  @@index([guildId, activeKey])
  @@map("units")
}

/// Mitglied einer Einheit, gebunden an eine laufende Schicht. `openKey` = 'open' solange aktiv: höchstens eine Einheit je Mitglied.
model UnitMember {
  id       String    @id @default(cuid())
  guildId  String
  unitId   String
  userId   String
  shiftId  String
  role     UnitRole  @default(MEMBER)
  openKey  String?
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, openKey])
  @@index([unitId])
  @@map("unit_members")
}

model UnitEvent {
  id      String   @id @default(cuid())
  guildId String
  unitId  String
  type    String
  at      DateTime @default(now())
  actorId String?
  data    Json?

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, at])
  @@map("unit_events")
}

// ---------------------------------------------------------------------------
// Phase 16: Funk & Funk-Whitelist
// ---------------------------------------------------------------------------

/// Funk-Sprachkanal. `area` SPECIAL = Spezialfunk; `requiresDuty` = nur mit laufender Schicht nutzbar.
model RadioChannel {
  id           String    @id @default(cuid())
  guildId      String
  channelId    String
  name         String
  area         RadioArea @default(GENERAL)
  requiresDuty Boolean   @default(false)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId])
  @@map("radio_channels")
}

/// Whitelist-Eintrag: höchstens einer je Mitglied und Server.
model RadioAccess {
  id        String     @id @default(cuid())
  guildId   String
  userId    String
  level     RadioLevel @default(SPEAK)
  /// Darf zusätzlich Spezialfunk nutzen (Vollzugriff hat ihn immer).
  special   Boolean    @default(false)
  reason    String?
  grantedBy String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, level])
  @@map("radio_access")
}

/// Verlauf der Whitelist (hinzugefügt, geändert, entfernt) – bleibt auch nach dem Entfernen erhalten.
model RadioEvent {
  id      String   @id @default(cuid())
  guildId String
  userId  String
  type    String
  at      DateTime @default(now())
  actorId String?
  data    Json?

  @@index([guildId, userId, at])
  @@map("radio_events")
}

// ---------------------------------------------------------------------------
// Phase 17: Einsatzsystem
// ---------------------------------------------------------------------------

/// Fortlaufende Einsatznummer je Server (atomar hochgezählt).
model OperationCounter {
  guildId String @id
  last    Int    @default(0)

  @@map("operation_counters")
}

model Operation {
  id          String            @id @default(cuid())
  guildId     String
  number      Int
  kind        String
  location    String
  priority    OperationPriority @default(NORMAL)
  description String?
  status      OperationStatus   @default(REQUESTED)
  /// Einsatzleiter (Discord-ID).
  leaderId    String?
  createdBy   String
  startedAt   DateTime?
  completedAt DateTime?
  /// Abschlussbericht (Pflicht beim Abschließen) bzw. Abbruchgrund.
  report      String?
  outcome     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  guild        Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  units        OperationUnit[]
  participants OperationParticipant[]
  events       OperationEvent[]

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([guildId, createdAt])
  @@map("operations")
}

/// Zugewiesene Einheit. `activeKey` = 'active' solange zugewiesen: eine Einheit ist höchstens in einem Einsatz.
model OperationUnit {
  id          String    @id @default(cuid())
  guildId     String
  operationId String
  unitId      String
  callsign    String
  activeKey   String?
  /// Status der Einheit vor der Zuweisung (wird danach wiederhergestellt).
  prevStatus  String?
  assignedAt  DateTime  @default(now())
  releasedAt  DateTime?

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([unitId, activeKey])
  @@index([operationId])
  @@map("operation_units")
}

/// Beteiligte Beamte (festgehalten bei Zuweisung und beim Abschluss) – Grundlage für die Personalakten-Einträge.
model OperationParticipant {
  id            String  @id @default(cuid())
  guildId       String
  operationId   String
  userId        String
  callsign      String?
  isLeader      Boolean @default(false)
  /// Personalakten-Eintrag, der aus diesem Einsatz entstanden ist (Doppelübernahme ausgeschlossen).
  recordEntryId String?

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, userId])
  @@map("operation_participants")
}

model OperationEvent {
  id          String   @id @default(cuid())
  guildId     String
  operationId String
  type        String
  at          DateTime @default(now())
  actorId     String?
  data        Json?

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, at])
  @@map("operation_events")
}

// ---------------------------------------------------------------------------
// Phase 18: Gefahrenstatus
// ---------------------------------------------------------------------------

/// Konfigurierbare Gefahrenstufe (Standard 0–5, werden beim ersten Zugriff angelegt).
model DangerLevel {
  id             String   @id @default(cuid())
  guildId        String
  level          Int
  name           String
  color          String   @default("#808080")
  emoji          String?
  description    String?
  /// Wer diese Stufe setzen darf (leer = jeder mit dem Recht `danger.set`).
  allowedRoleIds String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, level])
  @@map("danger_levels")
}

/// Aktuelle Stufe je Server (ohne Zeile: Stufe 0).
model DangerState {
  guildId   String   @id
  level     Int
  setBy     String
  reason    String?
  setAt     DateTime @default(now())
  /// Zuletzt veröffentlichte Statusmeldung (wird bei Änderungen aktualisiert).
  channelId String?
  messageId String?

  @@map("danger_state")
}

model DangerEvent {
  id        String   @id @default(cuid())
  guildId   String
  fromLevel Int?
  toLevel   Int
  actorId   String
  reason    String?
  at        DateTime @default(now())

  @@index([guildId, at])
  @@map("danger_events")
}

// ---------------------------------------------------------------------------
// Phase 19: Fahndungssystem
// ---------------------------------------------------------------------------

model WantedCounter {
  guildId String @id
  last    Int    @default(0)

  @@map("wanted_counters")
}

/// Fahndung nach einer Person oder einem Fahrzeug (getrennte Pflichtfelder je Art).
/// `activeKey` = 'active' solange aktiv: dieselbe Person/dasselbe Kennzeichen kann nicht doppelt aktiv gesucht werden.
model WantedNotice {
  id            String       @id @default(cuid())
  guildId       String
  number        Int
  kind          WantedKind
  status        WantedStatus @default(ACTIVE)
  /// Normalisierter Suchschlüssel (Name klein / Kennzeichen groß ohne Leerzeichen).
  subjectKey    String
  // Person
  subjectName   String?
  /// Optional: Discord-ID, falls die gesuchte Person ein Mitglied ist.
  subjectUserId String?
  appearance    String?
  // Fahrzeug
  plate         String?
  vehicleModel  String?
  vehicleColor  String?
  ownerName     String?
  // gemeinsam
  reason        String
  priority      String       @default("NORMAL")
  lastSeen      String?
  notes         String?
  activeKey     String?
  createdBy     String
  revokedBy     String?
  revokeReason  String?
  revokedAt     DateTime?
  /// Ende der Laufzeit; null = läuft nicht ab.
  expiresAt     DateTime?
  expiredAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  guild  Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  events WantedEvent[]

  @@unique([guildId, number])
  @@unique([guildId, kind, subjectKey, activeKey])
  @@index([guildId, kind, status])
  @@index([status, expiresAt])
  @@map("wanted_notices")
}

model WantedEvent {
  id       String   @id @default(cuid())
  guildId  String
  noticeId String
  type     String
  at       DateTime @default(now())
  actorId  String?
  data     Json?

  notice WantedNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId, at])
  @@map("wanted_events")
}

// ---------------------------------------------------------------------------
// Phase 20: Fahrzeuge & Strafen
// ---------------------------------------------------------------------------

/// Dienstfahrzeug. `activeKey` = 'active' solange im Bestand: Kennzeichen je Server nur einmal.
model Vehicle {
  id        String        @id @default(cuid())
  guildId   String
  plate     String
  plateKey  String
  type      String
  status    VehicleStatus @default(AVAILABLE)
  /// Zugewiesene Einheit (nur gültig, solange die Einheit besteht).
  unitId    String?
  /// Fahrer (Discord-ID, Personalakte über die Benutzer-ID verknüpft).
  driverId  String?
  notes     String?
  activeKey String?
  retiredAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  guild   Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  damages VehicleDamage[]
  events  VehicleEvent[]

  @@unique([guildId, plateKey, activeKey])
  @@index([guildId, status])
  @@map("vehicles")
}

model VehicleDamage {
  id          String         @id @default(cuid())
  guildId     String
  vehicleId   String
  description String
  severity    DamageSeverity @default(MINOR)
  reportedBy  String
  repairedAt  DateTime?
  repairedBy  String?
  createdAt   DateTime       @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, repairedAt])
  @@map("vehicle_damages")
}

model VehicleEvent {
  id        String   @id @default(cuid())
  guildId   String
  vehicleId String
  type      String
  at        DateTime @default(now())
  actorId   String?
  data      Json?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, at])
  @@map("vehicle_events")
}

model PenaltyCounter {
  guildId String @id
  last    Int    @default(0)

  @@map("penalty_counters")
}

/// RP-Strafe gegen eine Person (Name, optional Discord-ID), ausgestellt von einem Beamten (→ Eintrag in dessen Personalakte).
model Penalty {
  id               String        @id @default(cuid())
  guildId          String
  number           Int
  kind             PenaltyKind
  status           PenaltyStatus @default(ACTIVE)
  subjectName      String
  subjectKey       String
  subjectUserId    String?
  /// Bußgeld
  amount           Int?
  /// Strafpunkte
  points           Int?
  /// Führerscheinentzug: Dauer in Tagen und Ende
  durationDays     Int?
  until            DateTime?
  /// Kennzeichen (Beschlagnahmung / Tatfahrzeug)
  plate            String?
  reason           String
  issuedBy         String
  operationNumber  Int?
  /// Eintrag in der Personalakte des Ausstellers.
  personnelEntryId String?
  revokedBy        String?
  revokeReason     String?
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, number])
  @@index([guildId, subjectKey])
  @@index([guildId, issuedBy])
  @@map("penalties")
}

// ---------------------------------------------------------------------------
// Phase 21: Ausbildungssystem
// ---------------------------------------------------------------------------

/// Ausbildung (Vorlage): Theorie, Praxis und Prüfung mit je maximalen Punkten (0 = Teil entfällt), Bestehensgrenze, automatische Rolle.
model TrainingCourse {
  id              String   @id @default(cuid())
  guildId         String
  name            String
  description     String?
  active          Boolean  @default(true)
  theoryMax       Int      @default(0)
  practiceMax     Int      @default(0)
  examMax         Int      @default(0)
  /// Bestehensgrenze in Prozent der Gesamtpunkte (die Prüfung muss zusätzlich für sich bestanden sein).
  passPercent     Int      @default(60)
  /// Rolle, die bei Bestehen automatisch vergeben wird.
  grantRoleId     String?
  /// Wer sich anmelden darf (mind. eine dieser Rollen; leer = jeder).
  requiredRoleIds String[]
  maxParticipants Int      @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guild     Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  trainings Training[]

  @@unique([guildId, name])
  @@map("training_courses")
}

model TrainingCounter {
  guildId String @id
  last    Int    @default(0)

  @@map("training_counters")
}

/// Eine Durchführung einer Ausbildung (Termin) mit Ausbildern und Teilnehmern.
model Training {
  id              String         @id @default(cuid())
  guildId         String
  number          Int
  courseId        String
  status          TrainingStatus @default(PLANNED)
  scheduledAt     DateTime
  location        String?
  notes           String?
  trainerIds      String[]
  maxParticipants Int
  createdBy       String
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  guild        Guild                 @relation(fields: [guildId], references: [id], onDelete: Cascade)
  course       TrainingCourse        @relation(fields: [courseId], references: [id])
  participants TrainingParticipant[]
  events       TrainingEvent[]

  @@unique([guildId, number])
  @@index([guildId, status, scheduledAt])
  @@map("trainings")
}

model TrainingParticipant {
  id             String            @id @default(cuid())
  guildId        String
  trainingId     String
  userId         String
  status         ParticipantStatus @default(ENROLLED)
  theoryPoints   Int?
  practicePoints Int?
  examPoints     Int?
  /// Ergebnis in Prozent (erst, wenn alle Teile bewertet sind).
  percent        Float?
  gradedBy       String?
  finalizedAt    DateTime?
  /// Eintrag „TRAINING“ in der Personalakte (bei Bestehen).
  entryId        String?
  roleResult     String?
  joinedAt       DateTime          @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([guildId, userId])
  @@map("training_participants")
}

model TrainingEvent {
  id         String   @id @default(cuid())
  guildId    String
  trainingId String
  type       String
  at         DateTime @default(now())
  actorId    String?
  data       Json?

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId, at])
  @@map("training_events")
}

// ---------------------------------------------------------------------------
// Phase 22: Qualifikationssystem
// ---------------------------------------------------------------------------

/// Qualifikation (SEK, Flugstaffel, Ausbilder, Ermittler, Verkehrseinheit …) mit frei definierbaren Voraussetzungen.
model Qualification {
  id           String   @id @default(cuid())
  guildId      String
  name         String
  description  String?
  active       Boolean  @default(true)
  /// Voraussetzungen als Liste: { type: COURSE|QUALIFICATION|RANK|SERVICE_DAYS|SHIFT_HOURS, … }
  requirements Json     @default("[]")
  grantRoleId  String?
  /// Wird automatisch vergeben, sobald alle Voraussetzungen erfüllt sind (nach bestandener Ausbildung).
  autoGrant    Boolean  @default(false)
  /// Gültigkeit in Tagen (leer = unbegrenzt).
  validDays    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild  Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  awards QualificationAward[]

  @@unique([guildId, name])
  @@map("qualifications")
}

/// Vergabe. `activeKey` = 'active' solange nicht entzogen: je Mitglied und Qualifikation höchstens eine aktive.
model QualificationAward {
  id              String    @id @default(cuid())
  guildId         String
  qualificationId String
  userId          String
  activeKey       String?
  /// null = automatisch vergeben
  awardedBy       String?
  awardedAt       DateTime  @default(now())
  expiresAt       DateTime?
  /// Voraussetzungen wurden bewusst übergangen (mit Begründung).
  override        Boolean   @default(false)
  overrideReason  String?
  revokedAt       DateTime?
  revokedBy       String?
  revokeReason    String?
  entryId         String?
  roleResult      String?

  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@unique([qualificationId, userId, activeKey])
  @@index([guildId, userId])
  @@map("qualification_awards")
}

// ---------------------------------------------------------------------------
// Phase 23: Beförderungssystem
// ---------------------------------------------------------------------------

/// Voraussetzungen für einen Ziel-Dienstgrad (gleiche Bausteine wie Qualifikationen, automatisch prüfbar).
model PromotionRule {
  id           String   @id @default(cuid())
  guildId      String
  rankId       String
  requirements Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, rankId])
  @@map("promotion_rules")
}

model PromotionCounter {
  guildId String @id
  last    Int    @default(0)

  @@map("promotion_counters")
}

/// Beförderungsantrag. `pendingKey` = 'pending' solange offen: je Mitglied nur ein offener Antrag.
model PromotionRequest {
  id             String          @id @default(cuid())
  guildId        String
  number         Int
  userId         String
  recordId       String
  fromRankId     String?
  fromRankName   String?
  toRankId       String
  toRankName     String
  status         PromotionStatus @default(PENDING)
  pendingKey     String?
  requestedBy    String
  reason         String?
  /// Ergebnis der Voraussetzungsprüfung beim Antrag.
  checks         Json?
  /// Voraussetzungen wurden bewusst übergangen.
  override       Boolean         @default(false)
  decidedBy      String?
  decidedAt      DateTime?
  decisionReason String?
  roleResult     String?
  createdAt      DateTime        @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, number])
  @@unique([guildId, userId, pendingKey])
  @@index([guildId, status])
  @@index([guildId, userId])
  @@map("promotion_requests")
}

// ---------------------------------------------------------------------------
// Phase 24: SEK-Modul
// ---------------------------------------------------------------------------

/// Verknüpft das SEK mit den allgemeinen Systemen (je Server eine Konfiguration).
model SekConfig {
  guildId         String   @id
  /// Team in der Personalverwaltung (SEK-Personal).
  teamId          String?
  /// Qualifikation „SEK“ (Voraussetzung für die Mitgliedschaft).
  qualificationId String?
  /// Shift-Typ für SEK-Dienst.
  shiftTypeId     String?
  /// SEK-Ausbildungen.
  courseIds       String[]
  /// Bewerbung für den SEK (Einreichungen sichtbar mit sek.application.view).
  applicationId   String?
  updatedAt       DateTime @updatedAt

  @@map("sek_config")
}

/// Einsatzteam (Gruppe/Trupp), z. B. „Alpha“.
model SekSquad {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  leaderId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  guild      Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  members    SekSquadMember[]
  operations SekOperationSquad[]

  @@unique([guildId, name])
  @@map("sek_squads")
}

model SekSquadMember {
  id      String @id @default(cuid())
  guildId String
  squadId String
  userId  String
  /// Funktion im Team (Einsatzleiter, Scharfschütze, Einsatzsanitäter …).
  role    String @default("Operator")

  squad SekSquad @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([guildId, userId])
  @@map("sek_squad_members")
}

/// Kennzeichnet einen Einsatz als SEK-Einsatz.
model SekOperation {
  operationId String   @id
  guildId     String
  createdBy   String
  createdAt   DateTime @default(now())

  squads SekOperationSquad[]

  @@index([guildId])
  @@map("sek_operations")
}

model SekOperationSquad {
  id          String @id @default(cuid())
  operationId String
  squadId     String

  operation SekOperation @relation(fields: [operationId], references: [operationId], onDelete: Cascade)
  squad     SekSquad     @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@unique([operationId, squadId])
  @@map("sek_operation_squads")
}

// ---------------------------------------------------------------------------
// Phase 25: Ticket-System
// ---------------------------------------------------------------------------

model TicketCategory {
  id                String   @id @default(cuid())
  guildId           String
  name              String
  description       String?
  emoji             String?
  /// Discord-Kategorie, unter der die Ticket-Kanäle angelegt werden.
  discordCategoryId String?
  /// Rollen, die Tickets dieser Kategorie sehen und übernehmen dürfen.
  staffRoleIds      String[]
  defaultPriority   String   @default("NORMAL")
  /// Wie viele offene Tickets ein Mitglied je Kategorie haben darf.
  maxOpenPerUser    Int      @default(1)
  active            Boolean  @default(true)
  /// Embed-Farbe (RGB als Zahl); leer = Standardfarbe des Servers.
  color             Int?
  /// Gesamtkapazität: so viele offene Tickets sind gleichzeitig möglich (Basis der Auslastungsanzeige).
  maxOpenTotal      Int      @default(20)
  /// Wer ein Ticket dieser Kategorie eröffnen darf (leer = alle).
  requiredRoleIds   String[]
  /// Kanalname-Vorlage dieser Kategorie (leer = Vorlage des Servers).
  nameTemplate      String?
  /// Optionales Formular: [{ id, label, style: 'short'|'paragraph', required, placeholder? }] (max. 5).
  formFields        Json?
  /// null = Einstellung des Servers
  transcriptEnabled Boolean?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([guildId, name])
  @@map("ticket_categories")
}

/// Server-Einstellungen des Ticket-Systems (Texte, Kanäle, Rollen, Verhalten).
model TicketSettings {
  guildId               String   @id
  panelChannelId        String?
  panelMessageId        String?
  transcriptChannelId   String?
  /// Kategorie für „Ticket mit Bewerber“ (leer = erste aktive Kategorie).
  applicationCategoryId String?
  /// Administratoren: dürfen in jedem Ticket alles (zusätzlich zu den Teamrollen der Kategorie).
  adminRoleIds          String[]
  /// Platzhalter: {number} {user} {category}
  nameTemplate          String   @default("ticket-{number}-{user}")
  /// Minuten bis zum Löschen des Kanals nach dem Schließen (0 = sofort).
  deleteAfterMinutes    Int      @default(10)
  transcriptEnabled     Boolean  @default(true)
  dmTranscript          Boolean  @default(false)
  claimEnabled          Boolean  @default(true)
  /// Übernommene Tickets dürfen nur vom Bearbeiter (oder Admins) geschlossen/verändert werden.
  claimExclusive        Boolean  @default(false)
  closeWithReason       Boolean  @default(true)
  confirmClose          Boolean  @default(true)
  loadEnabled           Boolean  @default(true)
  hideFullCategories    Boolean  @default(false)
  color                 Int      @default(5793266)
  panelTitle            String   @default("🔷 Ticket-Support")
  panelDescription      String   @default("Wähle unten die passende Kategorie, um ein Ticket zu eröffnen.")
  selectPlaceholder     String   @default("🔽 Wähle eine Kategorie ...")
  loadTitle             String   @default("📊 Ticket Auslastung")
  loadText              String   @default("Hier siehst du die aktuelle Auslastung unserer Tickets. Bei einer höheren Auslastung kann es zu längeren Bearbeitungszeiten kommen. Ein Ticket kannst du jedoch jederzeit eröffnen, unabhängig von der Auslastung.")
  openTitle             String   @default("🎫 Ticket geöffnet")
  openText              String   @default("Hallo {user},\nvielen Dank, dass du den Support kontaktiert hast.\nBeschreibe dein Anliegen möglichst genau.\nEin Teammitglied wird sich schnellstmöglich um dein Anliegen kümmern.")
  updatedAt             DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("ticket_settings")
}

model TicketCounter {
  guildId String @id
  last    Int    @default(0)

  @@map("ticket_counters")
}

model Ticket {
  id                String       @id @default(cuid())
  guildId           String
  number            Int
  categoryId        String
  /// Ersteller (Discord-ID)
  userId            String
  subject           String
  description       String?
  status            TicketStatus @default(OPEN)
  priority          String       @default("NORMAL")
  /// Bearbeiter (Übernahme)
  claimedBy         String?
  claimedAt         DateTime?
  channelId         String?
  /// Zusätzlich hinzugefügte Mitglieder.
  participantIds    String[]
  closedBy          String?
  closedAt          DateTime?
  closeReason       String?
  /// Transkript (Nachrichten als JSON, beim Schließen festgehalten).
  transcript        Json?
  transcriptContent Boolean      @default(true)
  /// Fertiges HTML-Transcript (beim Schließen erzeugt und gespeichert).
  transcriptHtml    String?
  /// Antworten des Kategorie-Formulars: [{ label, value }]
  formAnswers       Json?
  /// Zugehörige Bewerbung, wenn das Ticket aus einer Bewerbung heraus eröffnet wurde.
  submissionId      String?
  /// Ab wann der Kanal eines geschlossenen Tickets gelöscht wird.
  deleteAt          DateTime?
  channelDeletedAt  DateTime?
  lastPingAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  guild    Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  category TicketCategory @relation(fields: [categoryId], references: [id])
  events   TicketEvent[]

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([guildId, userId])
  @@map("tickets")
}

model TicketEvent {
  id       String   @id @default(cuid())
  guildId  String
  ticketId String
  type     String
  at       DateTime @default(now())
  actorId  String?
  data     Json?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, at])
  @@map("ticket_events")
}

// ---------------------------------------------------------------------------
// Phase 26: Abmeldungen
// ---------------------------------------------------------------------------

model AbsenceCounter {
  guildId String @id
  last    Int    @default(0)

  @@map("absence_counters")
}

/// Abmeldung (Abwesenheit) mit Zeitraum (inklusive Start- und Endtag, Berlin-Kalender).
model Absence {
  id             String        @id @default(cuid())
  guildId        String
  number         Int
  userId         String
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  /// URLAUB | KRANK | BERUFLICH | SONSTIGES
  category       String
  /// Begründung des Antragstellers
  reason         String
  status         AbsenceStatus @default(PENDING)
  decidedBy      String?
  decidedAt      DateTime?
  decisionReason String?
  /// Vorzeitig beendet (zurückgemeldet) am …
  endedAt        DateTime?
  /// Eintrag „ABSENCE“ in der Personalakte (nach Genehmigung).
  entryId        String?
  createdAt      DateTime      @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, number])
  @@index([guildId, userId, status])
  @@index([guildId, status, startDate])
  @@map("absences")
}

// ---------------------------------------------------------------------------
// Phase 27: Tages- und Wochenberichte
// ---------------------------------------------------------------------------

/// Bericht (DAY/WEEK) mit festgehaltenen Zahlen. Je Server, Art und Zeitraum genau einer (Neuberechnung überschreibt).
model Report {
  id          String   @id @default(cuid())
  guildId     String
  kind        String
  /// Beginn des Zeitraums (Berlin-Mitternacht, als UTC-Zeitpunkt)
  periodStart DateTime
  periodEnd   DateTime
  data        Json
  channelId   String?
  messageId   String?
  generatedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, kind, periodStart])
  @@index([guildId, kind, periodStart])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Phase 31: Automatisierung
// ---------------------------------------------------------------------------

/// Ausgehende Benachrichtigung (DM oder Kanalnachricht) mit Wiederholungen. `dedupeKey` verhindert Doppelversand.
model Notification {
  id            String    @id @default(cuid())
  guildId       String
  /// USER (DM) | CHANNEL
  targetKind    String
  targetId      String
  kind          String
  dedupeKey     String
  payload       Json
  /// PENDING | SENT | FAILED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}

/// Vorberechnete Statistik (z. B. Ranglisten je Zeitraum), regelmäßig vom Worker aktualisiert.
model StatSnapshot {
  guildId    String
  key        String
  data       Json
  computedAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, key])
  @@map("stat_snapshots")
}

/// Protokoll der Hintergrund-Jobs (die letzten Läufe je Job).
model JobRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    Json?
  error      String?

  @@index([name, startedAt])
  @@map("job_runs")
}

// ---------------------------------------------------------------------------
// Phase 47: Sperren
// ---------------------------------------------------------------------------

enum RestrictionType {
  APPLICATION
  TICKET
  FACTION
  RADIO
}

enum RestrictionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// Sperre eines Benutzers (Bewerbung, Ticket, Fraktion, Funk). Wirksam, solange ACTIVE, Start erreicht und Ende (falls gesetzt) nicht erreicht.
model Restriction {
  id           String            @id @default(cuid())
  guildId      String
  userId       String
  type         RestrictionType
  reason       String
  note         String?
  status       RestrictionStatus @default(ACTIVE)
  startsAt     DateTime          @default(now())
  /// null = unbefristet.
  endsAt       DateTime?
  createdBy    String
  revokedBy    String?
  revokeReason String?
  revokedAt    DateTime?
  expiredAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, type, status])
  @@index([status, endsAt])
  @@map("restrictions")
}

/// Fortlaufender Zähler der Bewerbungs-IDs je Server und Präfix (z. B. POL-00152).
model ApplicationNumberCounter {
  guildId String
  prefix  String
  last    Int    @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, prefix])
  @@map("application_number_counters")
}
