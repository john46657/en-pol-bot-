# ---- Pflicht ----
# Bot-Token (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=
# Application ID / Client ID (Developer Portal → General Information)
DISCORD_CLIENT_ID=
# Client Secret (Developer Portal → OAuth2) – für den Dashboard-Login
DISCORD_CLIENT_SECRET=
# Öffentliche Adresse des Dashboards (ohne / am Ende). Im Developer Portal unter OAuth2 → Redirects
# muss <PUBLIC_URL>/auth/callback eingetragen sein.
PUBLIC_URL=http://localhost:3000
# Langer Zufallswert (mind. 32 Zeichen) – signiert Login-Sitzungen und Bewerbungslinks
SESSION_SECRET=

# ---- Optional ----
# Port des Webservers (Hoster geben oft SERVER_PORT oder PORT vor)
PORT=3000
# Ordner für die Daten (data.json + Sicherungen)
DATA_DIR=./data
# true = Server-Members-Intent nutzen (im Developer Portal aktivieren!) – nötig für „Aktion beim Verlassen“
MEMBERS_INTENT=false
# off = keine Roblox-Abfrage (Frage „Roblox User“ wird dann nur auf das Namensformat geprüft)
ROBLOX_LOOKUP=on
# Zeitzone für Statistik und Datumsangaben
TIMEZONE=Europe/Berlin
