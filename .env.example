# ---------- Pflicht (Produktion; deploy/setup-server.sh erzeugt diese Datei automatisch) ----------
DOMAIN=nexus.example.com
POSTGRES_PASSWORD=change-me
# 64 zufällige Hex-Zeichen, z. B.: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-random-hex-chars

# ---------- Discord-Bot (optional, siehe docs/discord-bot.md) ----------
# Gemeinsames Geheimnis API <-> Bot (mind. 32 Zeichen, z. B. openssl rand -hex 32). Leer = Bot-Zugang deaktiviert.
BOT_API_TOKEN=
DISCORD_TOKEN=
# Optional, aber empfohlen: Server-ID => Slash-Commands erscheinen sofort statt nach bis zu 1 Stunde
DISCORD_GUILD_ID=

# ---------- KI-Bewerbungsprüfung (optional, siehe docs/applications.md) ----------
# Schlüssel NUR hier auf dem Server eintragen – nie ins Repository, ins Frontend oder in Discord. Ohne Schlüssel = KI-Prüfung aus.
# Anbieter: gemini | groq | openrouter | mistral | ollama (leer = der erste Anbieter, für den ein Schlüssel hinterlegt ist)
# AI_PROVIDER=gemini
# Google Gemini (https://aistudio.google.com → „Get API key“)
GEMINI_API_KEY=
# Weitere Anbieter (OpenAI-kompatibel); kostenlose Kontingente sind möglich, aber nicht garantiert
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# Ollama (selbst betrieben, kein Schlüssel): AI_PROVIDER=ollama + Adresse
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Modell überschreiben (Standard je Anbieter, z. B. gemini-3.8-flash / llama-3.3-70b-versatile); GEMINI_MODEL bleibt gültig
# AI_MODEL=
# Grenzen (Standardwerte): Analysen je 24 h, gleichzeitige Analysen, Zeitlimit je Anfrage, Wiederholungen, max. Zeichen je Bewerbung
# AI_REVIEW_DAILY_LIMIT=50
# AI_REVIEW_MAX_CONCURRENT=2
# AI_REVIEW_TIMEOUT_MS=45000
# AI_REVIEW_MAX_RETRIES=1
# AI_REVIEW_MAX_INPUT_CHARS=12000

# ---------- Lokale Entwicklung (apps/api/.env) ----------
# DATABASE_URL=postgresql://enrp:enrp@localhost:54329/enrp
# WEB_ORIGIN=http://localhost:5173
# SESSION_TTL_HOURS=12
# LOGIN_RATE_LIMIT=10   # Login-Versuche pro Minute und IP

