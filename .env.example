# NEXUS – Environment Variablen (kopieren nach .env und ausfüllen)

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://nexus:nexus_dev_password@localhost:5432/nexus?schema=public"

# --- Redis (BullMQ / Cache) ---
REDIS_URL="redis://localhost:6379"
QUEUE_PREFIX="nexus"

# --- Discord ---
# Bot Token aus dem Discord Developer Portal
DISCORD_TOKEN=""
# Client ID der Discord Application
DISCORD_CLIENT_ID=""
# Client Secret der Discord Application (für OAuth2)
DISCORD_CLIENT_SECRET=""
# Optional: Dev-Server-Guild für sofortige Slash-Command-Synchronisation
DISCORD_DEV_GUILD_ID=""

# --- Auth ---
# Session-Secret (lange zufällige Zeichenfolge, z. B. `openssl rand -hex 32`)
AUTH_SECRET=""
AUTH_CALLBACK_URL="http://localhost:3000/api/v1/auth/discord/callback"
JWT_ISSUER="nexus"

# --- API ---
API_PORT=3000
API_URL="http://localhost:3000"

# --- Dashboard ---
DASHBOARD_PORT=3001
DASHBOARD_URL="http://localhost:3001"

# --- Hochgeladene Design-Bilder (Logo, Hintergründe, Widget-Bilder) ---
# Speicherordner der API (je Server ein Unterordner). In Produktion auf ein dauerhaftes Volume legen und mitsichern.
STORAGE_DIR="./data/uploads"

# --- Object Storage (S3-kompatibel) ---
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# --- Integrations (verschlüsselt abgelegt, nie loggen) ---
INTEGRATION_ENCRYPTION_KEY=""

# --- Observability ---
LOG_LEVEL="info"
SENTRY_DSN=""

# --- Limits (je Plan entziehbar, vgl. packages/config) ---
NEXUS_MAX_APPLICATIONS="50"
NEXUS_MAX_QUESTIONS_PER_APPLICATION="100"
NEXUS_MAX_ACTIVE_SUBMISSIONS_PER_USER="5"

# --- AI (optional) ---
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
