# EN Polizei – Einstellungen fürs Panel-Hosting.
# Entweder als Umgebungsvariablen im Panel eintragen ODER diese Datei als ".env" speichern (ohne .example).

# --- PFLICHT ---
# PostgreSQL-Zugang aus dem Datenbank-Bereich deines Panels (Host, Port, Benutzer, Passwort, Datenbankname):
DATABASE_URL=postgresql://BENUTZER:PASSWORT@HOST:5432/DATENBANKNAME

# --- Empfohlen ---
# Passwort für den ersten Administrator "admin" (sonst wird eins erzeugt und EINMALIG in der Konsole angezeigt):
ADMIN_PASSWORD=
# true, wenn du die Seite über HTTPS aufrufst (z. B. Panel-Domain https://xxxx.apps.bot-hosting.cloud). false/leer = ohne Verschlüsselung (unsicher!)
COOKIE_SECURE=
# Deine Adresse aus dem Browser (mit https://, ohne / am Ende). Empfohlen, wenn dein Panel eine Domain bereitstellt:
WEB_ORIGIN=

# --- Discord-Bot (optional; leer = Bot wird nicht gestartet) ---
DISCORD_TOKEN=
# Server-ID => Slash-Commands erscheinen sofort
DISCORD_GUILD_ID=

# --- Selten nötig ---
# PORT=            (Panels setzen SERVER_PORT automatisch)
# SESSION_TTL_HOURS=12
# LOGIN_RATE_LIMIT=10
# NODE_OPTIONS=--max-old-space-size=200   (bei knappem Arbeitsspeicher)
