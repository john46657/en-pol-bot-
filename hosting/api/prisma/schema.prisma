generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Identity & RBAC ─────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  displayName        String
  email              String?   @unique
  passwordHash       String
  robloxUserId       String?   @unique
  robloxUsername     String?
  robloxStatus       String    @default("UNVERIFIED") // UNVERIFIED | VERIFIED | FAILED | MANUAL
  robloxVerifiedAt   DateTime?
  robloxVerifiedById String?   @db.Uuid
  active             Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLogin          DateTime?
  /// Zwei-Faktor (TOTP): Geheimnis verschlüsselt; aktiv ab totpEnabledAt. Wiederherstellungscodes nur als SHA-256.
  totpSecret         String?
  totpPending        String?
  totpEnabledAt      DateTime?
  totpLastStep       Int?
  totpRecovery       String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)

  roles         UserRole[]
  groups        GroupMember[]
  overrides     UserPermissionOverride[]
  sessions      Session[]
  loginHistory  LoginHistory[]
  notifications Notification[]
  personnel     Personnel?
  dutySessions  DutySession[]
  leaveRequests LeaveRequest[]
  settings      UserSettings?
  editLocks     EditLock[]

  @@index([robloxUsername])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @unique
  description    String?
  system         Boolean          @default(false)
  /// Rang in der Hierarchie: kleiner = höher (1 = Serverbesitzer). Nur Rollen unterhalb der eigenen dürfen verwaltet werden.
  priority       Int              @default(100)
  color          String?
  icon           String?
  /// Deaktivierte Rollen verleihen keine Rechte (bleiben aber zugewiesen).
  active         Boolean          @default(true)
  /// Discord-Rollen, die diese Dashboard-Rolle automatisch verleihen (Abgleich bei Login und regelmäßig).
  discordRoleIds String[]         @default([])
  /// Discord-Server, auf dem die Rolle gilt (null = alle Server). Server laufen getrennt.
  guildId        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  users          UserRole[]
  permissions    RolePermission[]
}

model Permission {
  key         String                   @id // z. B. "dispatch.view"
  module      String
  description String?
  roles       RolePermission[]
  overrides   UserPermissionOverride[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId        String     @db.Uuid
  permissionKey String
  effect        String     @default("ALLOW") // ALLOW | DENY
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model Group {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  description String?
  members     GroupMember[]
  roles       GroupRole[]
}

model GroupRole {
  groupId String @db.Uuid
  roleId  String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, roleId])
}

model GroupMember {
  groupId String @db.Uuid
  userId  String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model UserPermissionOverride {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  permissionKey String
  effect        String // ALLOW | DENY
  reason        String?
  createdById   String?    @db.Uuid
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([userId, permissionKey])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  username  String
  success   Boolean
  reason    String?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([username, createdAt])
}

model UserSettings {
  userId          String @id @db.Uuid
  theme           String @default("dark")
  timezone        String @default("Europe/Berlin")
  dashboardLayout Json?
  notifications   Json?
  /// Persönliches Design, Favoriten, Schnellzugriff, Benachrichtigungen, Ansichten (nur für den Benutzer selbst)
  preferences     Json?
  /// Mehrere persönliche Startseiten-Layouts mit Widgets
  layouts         Json?
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── Records ─────────────

model Person {
  id             String   @id @default(uuid()) @db.Uuid
  serverId       String?  @db.Uuid
  robloxUserId   String? // eindeutig je Akten-Bereich (serverId), siehe Server-Verbund
  robloxUsername String
  aliases        String[] @default([])
  status         String   @default("ACTIVE") // ACTIVE | ARCHIVED
  notes          String?
  custom         Json? // Werte der in Studio definierten Custom Fields
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  version        Int      @default(1)

  vehicles Vehicle[]
  links    RecordLink[]
  tickets  Ticket[]

  @@unique([serverId, robloxUserId])
  @@index([robloxUsername])
}

model Vehicle {
  id            String   @id @default(uuid()) @db.Uuid
  serverId      String?  @db.Uuid
  plate         String
  model         String?
  color         String?
  ownerId       String?  @db.Uuid
  status        String   @default("ACTIVE")
  erlcReference String?
  notes         String?
  custom        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)
  owner         Person?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([serverId, plate])
  @@index([plate])
}

/**
 * Generische, dedupe-sichere Verknüpfung Datensatz <-> Person/Fahrzeug.
 */
model RecordLink {
  id         String   @id @default(uuid()) @db.Uuid
  personId   String?  @db.Uuid
  vehicleId  String?  @db.Uuid
  entityType String
  entityId   String
  role       String   @default("SUBJECT") // SUBJECT | SUSPECT | WITNESS | VICTIM | ...
  createdAt  DateTime @default(now())
  person     Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, entityType, entityId, role])
  @@index([entityType, entityId])
}

model LegalCode {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  title         String
  description   String?
  category      String
  penalty       Json
  active        Boolean   @default(true)
  effectiveDate DateTime  @default(now())
  expiresAt     DateTime?
  tickets       Ticket[]
}

model Ticket {
  id          String     @id @default(uuid()) @db.Uuid
  number      String     @unique
  personId    String     @db.Uuid
  officerId   String     @db.Uuid
  legalCodeId String?    @db.Uuid
  reason      String
  amount      Decimal    @default(0) @db.Decimal(12, 2)
  status      String     @default("ISSUED")
  notes       String?
  reportId    String?    @db.Uuid
  voidReason  String?
  voidedById  String?    @db.Uuid
  issuedAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  version     Int        @default(1)
  person      Person     @relation(fields: [personId], references: [id])
  legalCode   LegalCode? @relation(fields: [legalCodeId], references: [id])

  @@index([personId])
  @@index([officerId])
}

model Unit {
  id            String         @id @default(uuid()) @db.Uuid
  callsign      String         @unique
  status        String         @default("OFF_DUTY")
  vehicle       String?
  notes         String?
  /// CAD: Anzeigename, Einheitentyp (Schlüssel aus der CAD-Konfiguration, z. B. SEK/K9), Darstellung, Zuordnung
  name          String?
  type          String?
  color         String?
  icon          String?
  discordRoleId String?
  /// Discord-Server, zu dem die Einheit gehört (z. B. SEK/K9-Server)
  guildId       String?
  erlcTeam      String?
  operational   Boolean        @default(true)
  /// Manuell gesetzte Kartenposition (ER:LC-Koordinaten), falls kein verknüpfter Spieler im Spiel ist
  mapX          Float?
  mapZ          Float?
  /// Discord-Rollen, die den Status dieser Einheit melden dürfen (zusätzlich zu Leitstelle, Besatzung und discordRoleId)
  statusRoleIds String[]       @default([])
  members       UnitMember[]
  incidents     IncidentUnit[]
  updatedAt     DateTime       @updatedAt
}

model UnitMember {
  unitId String @db.Uuid
  userId String @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([unitId, userId])
}

model Incident {
  id              String           @id @default(uuid()) @db.Uuid
  serverId        String?          @db.Uuid
  number          String           @unique
  title           String
  description     String?
  priority        String           @default("MEDIUM")
  location        String?
  source          String           @default("MANUAL") // MANUAL
  status          String           @default("NEW")
  dispatcherId    String?          @db.Uuid
  supervisorId    String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  closedAt        DateTime?
  version         Int              @default(1)
  units           IncidentUnit[]
  /// CAD-Felder: Einsatzart, Stichwort, Kartenposition (ER:LC-Koordinaten), Beteiligte, benötigte Einheiten, interne Notizen
  type            String?
  keyword         String?
  mapX            Float?
  mapZ            Float?
  involved        String?
  requiredUnits   String?
  internalNotes   String?
  /// Discord-Server, auf dem der Einsatz geführt wird (Leitstelle)
  guildId         String?
  /// Vertraulich: nur diese Dashboard-Rollen (und CAD-Verwaltung/Disponent) sehen den Einsatz; leer = alle mit cad.view
  restrictRoleIds String[]         @default([])
  log             CadIncidentLog[]

  @@index([status, priority])
}

model IncidentUnit {
  incidentId String    @db.Uuid
  unitId     String    @db.Uuid
  assignedAt DateTime  @default(now())
  clearedAt  DateTime?
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([incidentId, unitId])
}

model Report {
  id             String          @id @default(uuid()) @db.Uuid
  number         String          @unique
  type           String
  title          String
  status         String          @default("DRAFT")
  authorId       String          @db.Uuid
  incidentId     String?         @db.Uuid
  currentVersion Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  version        Int             @default(1)
  versions       ReportVersion[]

  @@index([status])
}

model ReportVersion {
  id            String   @id @default(uuid()) @db.Uuid
  reportId      String   @db.Uuid
  version       Int
  authorId      String   @db.Uuid
  changeSummary String
  content       Json
  contentHash   String
  createdAt     DateTime @default(now())
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, version])
}

model Complaint {
  id             String   @id @default(uuid()) @db.Uuid
  number         String   @unique
  complainantId  String?  @db.Uuid
  subjectId      String?  @db.Uuid
  officerId      String?  @db.Uuid
  category       String
  description    String
  status         String   @default("RECEIVED")
  investigatorId String?  @db.Uuid
  findings       String?
  resolution     String?
  internalNotes  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  version        Int      @default(1)

  @@index([status])
}

model Investigation {
  id          String   @id @default(uuid()) @db.Uuid
  caseNumber  String   @unique
  title       String
  description String?
  leadId      String?  @db.Uuid
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
}

model WantedRecord {
  id          String    @id @default(uuid()) @db.Uuid
  personId    String?   @db.Uuid
  vehicleId   String?   @db.Uuid
  reason      String
  description String?
  priority    String    @default("MEDIUM")
  status      String    @default("ACTIVE")
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  @@index([status])
}

model Evidence {
  id              String             @id @default(uuid()) @db.Uuid
  number          String             @unique
  caseRef         String?
  type            String
  description     String
  source          String?
  ownerId         String?            @db.Uuid
  storageLocation String?
  custodyState    String             @default("COLLECTED")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  version         Int                @default(1)
  transfers       EvidenceTransfer[]
}

model EvidenceTransfer {
  id         String   @id @default(uuid()) @db.Uuid
  evidenceId String   @db.Uuid
  fromUserId String?  @db.Uuid
  toUserId   String?  @db.Uuid
  fromState  String
  toState    String
  reason     String
  confirmed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
}

// ───────────── Personnel / Dienst ─────────────

model Personnel {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @db.Uuid
  rank               String?
  team               String?
  callsign           String?             @unique
  /// Büro (Liste unter Einstellungen → Teamstruktur)
  office             String?
  /// Dienstnummer
  serviceNumber      String?             @unique
  employmentStatus   String              @default("ACTIVE")
  joinDate           DateTime            @default(now())
  qualifications     String[]            @default([])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  academyEnrollments AcademyEnrollment[]
  records            PersonnelRecord[]
}

/// Beförderungen, Auszeichnungen, Disziplinarmaßnahmen (nur mit personnel.* sichtbar).
model PersonnelRecord {
  id          String    @id @default(uuid()) @db.Uuid
  personnelId String    @db.Uuid
  type        String // PROMOTION | AWARD | DISCIPLINE | NOTE
  summary     String
  details     String?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@index([personnelId, createdAt])
}

model DutySession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  status    String
  unitId    String?   @db.Uuid
  callsign  String?
  /// Schicht-Art (Admin → Shifts), z. B. „Im Dienst“
  shiftType String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
}

/// Abmeldung (Leave of Absence): Antrag → Freigabe → Rolle „abgemeldet“ von Beginn bis Ende.
model LeaveRequest {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique
  userId         String    @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  reason         String
  status         String    @default("PENDING") // PENDING | APPROVED | DENIED | CANCELLED | ENDED
  guildId        String?
  decidedById    String?   @db.Uuid
  decidedAt      DateTime?
  decisionReason String?
  roleApplied    Boolean   @default(false)
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, startsAt])
  @@index([userId])
}

model Application {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique
  status         String    @default("SUBMITTED")
  answers        Json
  grantRoleIds   String[]  @default([]) // Discord-Rollen aus Rollen-Auswahl-Fragen, vergeben bei Annahme
  guildId        String? // Discord-Server, auf dem die Bewerbung gestartet wurde
  robloxUsername String
  robloxUserId   String?
  decidedById    String?   @db.Uuid
  /// Zeitpunkt der Annahme/Ablehnung (für die Statistik)
  decidedAt      DateTime?
  discordId      String? // Bewerber-Discord-ID (bei Bewerbung über den Bot) – für die Entscheidungs-DM
  discordName    String?
  source         String    @default("WEB") // WEB | DISCORD
  durationSec    Int? // Dauer der Bewerbung im Discord-Chat
  joinedAt       DateTime? // Beitritt zum Discord-Server
  decisionReason String? // Begründung für den Bewerber (Discord „… mit Grund“), geht per DM raus
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  @@index([status])
}

model AcademyCourse {
  id           String              @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  passScore    Int                 @default(70)
  instructorId String?             @db.Uuid
  enrollments  AcademyEnrollment[]
}

model AcademyEnrollment {
  id          String          @id @default(uuid()) @db.Uuid
  courseId    String          @db.Uuid
  personnelId String          @db.Uuid
  createdAt   DateTime        @default(now())
  course      AcademyCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  personnel   Personnel       @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  results     AcademyResult[]

  @@unique([courseId, personnelId])
}

model AcademyResult {
  id           String            @id @default(uuid()) @db.Uuid
  enrollmentId String            @db.Uuid
  score        Int
  passed       Boolean
  gradedById   String?           @db.Uuid
  createdAt    DateTime          @default(now())
  enrollment   AcademyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

// ───────────── Kommunikation ─────────────

model Conversation {
  id       String    @id @default(uuid()) @db.Uuid
  channel  String // TEAM | DISPATCH | INCIDENT | SUPERVISOR | ANNOUNCEMENT
  title    String?
  entityId String?
  messages Message[]
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  authorId       String       @db.Uuid
  body           String
  replyToId      String?      @db.Uuid
  pinned         Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Media {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String
  mime         String
  size         Int
  hash         String
  storageKey   String   @unique
  uploaderId   String   @db.Uuid
  linkedType   String?
  linkedId     String?
  createdAt    DateTime @default(now())

  @@index([linkedType, linkedId])
}

// ───────────── Timeline & Audit ─────────────

/**
 * Operative Historie (sichtbar für Fachanwender).
 */
model TimelineEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String
  action     String
  summary    String
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

/**
 * Technische Nachvollziehbarkeit. Append-only; durch DB-Trigger gegen UPDATE/DELETE geschützt.
 */
model AuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  actorUserId       String?  @db.Uuid
  actorRobloxUserId String?
  action            String
  module            String
  entityType        String?
  entityId          String?
  before            Json?
  after             Json?
  reason            String?
  requestId         String?
  createdAt         DateTime @default(now())

  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String // LOGIN_FAILURE | PERMISSION_DENIED | WEBHOOK_FAILURE | INVALID_TOKEN | RATE_LIMIT | SUSPICIOUS
  userId    String?  @db.Uuid
  ip        String?
  detail    String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────── Discord-Bot ─────────────

/// Verknüpfung Discord-Konto ↔ Systembenutzer. Alle Bot-Befehle laufen mit den Rechten dieses Benutzers.
model DiscordLink {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  discordId String   @unique
  linkedAt  DateTime @default(now())
}

/// Einmal-Code zum Verknüpfen (nur der Hash wird gespeichert, 10 Minuten gültig, einmal verwendbar).
model DiscordLinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Ausgangs-Warteschlange für Discord-Nachrichten (Bot holt ab und quittiert).
model DiscordOutbox {
  id         String    @id @default(uuid()) @db.Uuid
  type       String
  channelKey String // dispatch | wanted | announcements
  payload    Json
  attempts   Int       @default(0)
  lastError  String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([sentAt, createdAt])
}

/// Funk-Freigabe (Whitelist): nur freigegebene Mitglieder gelten als funkberechtigt.
model RadioWhitelist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  addedById String?  @db.Uuid
  createdAt DateTime @default(now())
}

/**
 * SEK (Spezialeinsatzkommando): eigenes Roster und eigene Einsatzberichte (Bewerbung: QualificationApplication).
 */
model SekMember {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  addedById String?  @db.Uuid
  createdAt DateTime @default(now())
}

model SekReport {
  id          String   @id @default(uuid()) @db.Uuid
  number      String   @unique
  authorId    String   @db.Uuid
  occurredAt  DateTime
  missionType String
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/**
 * Bewerbungen für Qualifikationen (SEK, Flugstaffel, Ausbilder …) – per Discord-Panel, Fragen einzeln per Direktnachricht.
 */
model QualificationApplication {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique
  unit           String
  unitName       String
  discordId      String
  discordName    String
  userId         String?   @db.Uuid
  answers        Json
  grantRoleIds   String[]  @default([]) // Discord-Rollen aus Rollen-Auswahl-Fragen, vergeben bei Annahme
  guildId        String? // Discord-Server, auf dem die Bewerbung gestartet wurde
  status         String    @default("OPEN")
  decidedById    String?   @db.Uuid
  decidedAt      DateTime?
  decisionReason String? // geht per DM an die Person
  durationSec    Int?
  joinedAt       DateTime?
  createdAt      DateTime  @default(now())

  @@index([discordId, status])
  @@index([status, createdAt])
}

// ================= Ticket-System (alles über das Dashboard konfigurierbar) =================

/**
 * Panel in einem Discord-Channel (Embed + Buttons oder Dropdown mit Ticket-Kategorien).
 */
model TicketPanel {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  guildId          String? // Discord-Server (leer = alle Server)
  title            String   @default("")
  description      String   @default("")
  emoji            String?
  color            Int      @default(3899638)
  thumbnailUrl     String?
  imageUrl         String?
  bannerUrl        String?
  footer           String?
  footerIconUrl    String?
  authorName       String?
  authorIconUrl    String?
  style            String   @default("BUTTONS") // BUTTONS | DROPDOWN
  placeholder      String   @default("Wähle eine Kategorie …")
  channelId        String? // Ziel-Channel für das Panel
  categoryIds      String[] @db.Uuid // verfügbare Ticket-Arten in dieser Reihenfolge
  allowedRoleIds   String[] // Discord-Rollen, die dieses Panel benutzen dürfen (leer = alle)
  /// Ticketauslastung im Panel anzeigen (offene Tickets je Kategorie)
  showLoad         Boolean  @default(false)
  position         Int      @default(0)
  messageChannelId String?
  messageId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TicketCategory {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String
  guildId                String? // Discord-Server (leer = alle Server)
  description            String   @default("")
  emoji                  String?
  color                  Int      @default(3899638)
  buttonStyle            String   @default("secondary")
  position               Int      @default(0)
  active                 Boolean  @default(true)
  discordCategoryId      String? // Discord-Kategorie für neue Ticket-Channels
  channelNameFormat      String   @default("ticket-{username}")
  staffRoleIds           String[] // zuständige Discord-Rollen (sehen + schreiben)
  extraRoleIds           String[] // zusätzliche Discord-Rollen (sehen + schreiben)
  accessRoleNames        String[] // Systemrollen, die diese Tickets im Dashboard sehen (leer = alle mit ticket.view)
  requiredRoleIds        String[] // Discord-Rollen, die zum Öffnen nötig sind (leer = alle)
  allowedUserIds         String[] // nur diese Discord-Benutzer dürfen öffnen (leer = alle)
  maxOpen                Int      @default(1) // 0 = unbegrenzt
  cooldownMinutes        Int      @default(0)
  defaultPriorityId      String?  @db.Uuid
  questions              Json     @default("[]")
  welcomeTitle           String   @default("🎫 {category}")
  welcomeMessage         String   @default("Hallo {user}!\n\nBeschreibe dein Anliegen so genau wie möglich. Ein Teammitglied kümmert sich schnellstmöglich darum.")
  mentionStaff           Boolean  @default(true)
  mentionText            String   @default("")
  buttons                Json     @default("[]")
  claimMode              String   @default("SINGLE") // SINGLE | MULTI | PRIMARY
  claimMessage           String   @default("👤 Bearbeiter: {staff}")
  claimNotifyStaff       Boolean  @default(false)
  creatorCanClose        Boolean  @default(true)
  closeReasonMode        String   @default("OPTIONAL") // NONE | OPTIONAL | REQUIRED
  closeReasonSource      String   @default("BOTH") // PRESET | CUSTOM | BOTH
  closeRemovesAccess     Boolean  @default(true)
  allowReopen            Boolean  @default(true)
  transcriptOnClose      Boolean  @default(true)
  transcriptChannelId    String?
  transcriptToUser       Boolean  @default(false)
  ratingEnabled          Boolean  @default(true)
  ratingQuestion         String   @default("Wie zufrieden warst du mit dem Support?")
  autoCloseMinutes       Int      @default(0) // 0 = aus
  autoCloseWarnMinutes   Int      @default(0) // Warnung so viele Minuten vorher (0 = keine)
  autoCloseMessage       String   @default("⏰ {user}, dieses Ticket wird bald wegen Inaktivität geschlossen. Schreib eine Nachricht, wenn du noch Hilfe brauchst.")
  deleteAfterMinutes     Int      @default(-1) // -1 = nie, 0 = sofort
  escalationRoleIds      String[]
  escalationPriorityId   String?  @db.Uuid
  escalationMessage      String   @default("🟠 Dieses Ticket wurde eskaliert. {staff}")
  /// wie GalaxyBot: Bild im Eröffnungs-Embed
  welcomeImageUrl        String?
  /// Auslastung: ab so vielen offenen Tickets gilt die Kategorie als voll (0 = aus)
  capacity               Int      @default(0)
  /// Ersteller darf weitere Personen hinzufügen
  creatorCanAddUsers     Boolean  @default(false)
  /// Nach Übernahme in diese Discord-Kategorie verschieben (Claim-Kategorie)
  claimDiscordCategoryId String?
  /// Nach Übernahme dürfen nur noch Bearbeiter, Ersteller und Zusatzrollen schreiben
  claimLocksChat         Boolean  @default(false)
  /// Auto-Claim, sobald ein Teammitglied schreibt
  autoClaimOnMessage     Boolean  @default(false)
  /// Auto-Unclaim nach so vielen Minuten Inaktivität (0 = aus)
  autoUnclaimMinutes     Int      @default(0)
  /// Auto-Team-Alert: Bearbeiter nach so vielen Minuten markieren, nach derselben Zeit freigeben (0 = aus)
  staffAlertMinutes      Int      @default(0)
  /// Close-Request: bestätigt der Ersteller, wird sofort geschlossen
  closeRequestCloses     Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model TicketStatus {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  emoji        String  @default("")
  color        Int     @default(3899638)
  position     Int     @default(0)
  kind         String  @default("OPEN") // OPEN | CLOSED | ARCHIVED
  isDefault    Boolean @default(false) // neue / wieder geöffnete Tickets
  isClaimed    Boolean @default(false) // beim Übernehmen
  isEscalation Boolean @default(false) // beim Eskalieren
  isClose      Boolean @default(false) // beim Schließen
}

model TicketPriority {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  emoji            String   @default("")
  color            Int      @default(3899638)
  position         Int      @default(0)
  isDefault        Boolean  @default(false)
  allowedRoleNames String[] // Systemrollen, die diese Priorität setzen dürfen (leer = alle mit ticket.change_priority)
  notifyRoleIds    String[] // Discord-Rollen, die bei dieser Priorität benachrichtigt werden
}

model TicketCloseReason {
  id       String @id @default(uuid()) @db.Uuid
  text     String
  position Int    @default(0)
}

/**
 * Support-Ticket (nicht zu verwechseln mit `Ticket` = Strafzettel).
 */
model SupportTicket {
  id               String    @id @default(uuid()) @db.Uuid
  number           Int       @unique @default(autoincrement())
  categoryId       String    @db.Uuid
  panelId          String?   @db.Uuid
  guildId          String
  channelId        String?   @unique
  controlMessageId String?
  name             String
  creatorId        String // Discord-ID
  creatorName      String
  creatorUserId    String?   @db.Uuid
  statusId         String    @db.Uuid
  priorityId       String?   @db.Uuid
  claimers         String[] // Discord-IDs; erster = Hauptbearbeiter (PRIMARY)
  answers          Json      @default("[]")
  questionIndex    Int       @default(0)
  locked           Boolean   @default(false)
  closeReason      String?
  closedById       String?
  closedByName     String?
  closedAt         DateTime?
  firstResponseAt  DateTime?
  lastActivityAt   DateTime  @default(now())
  warnedAt         DateTime?
  staffAlertedAt   DateTime?
  closeRequestedAt DateTime?
  deleteAt         DateTime?
  deletedAt        DateTime?
  escalatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([creatorId, categoryId])
  @@index([statusId])
  @@index([createdAt])
}

/**
 * Zusätzlicher Zugriff im Ticket (Benutzer oder Rolle), optional befristet.
 */
model TicketAccess {
  id        String    @id @default(uuid()) @db.Uuid
  ticketId  String    @db.Uuid
  targetId  String
  kind      String // USER | ROLE
  expiresAt DateTime?
  addedById String?
  createdAt DateTime  @default(now())

  @@unique([ticketId, targetId])
}

model TicketMessage {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  discordId    String?  @unique
  authorId     String
  authorName   String
  authorAvatar String?
  isStaff      Boolean  @default(false)
  isBot        Boolean  @default(false)
  content      String   @default("")
  attachments  Json     @default("[]") // [{name, size, contentType, storageKey?, url}]
  embeds       Json     @default("[]")
  createdAt    DateTime @default(now())

  @@index([ticketId, createdAt])
}

/**
 * Interne Notizen – nur für berechtigte Mitarbeiter, nie für den Ersteller.
 */
model TicketNote {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  authorId     String? // Discord-ID
  authorUserId String?  @db.Uuid
  authorName   String
  text         String
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model TicketLog {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  action    String
  actorId   String? // Discord-ID
  actorName String?
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketTranscript {
  id            String   @id @default(uuid()) @db.Uuid
  ticketId      String   @db.Uuid
  ticketNumber  Int
  categoryName  String
  creatorId     String
  creatorName   String
  claimers      String[]
  statusName    String
  html          String
  sizeBytes     Int
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model TicketRating {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @unique @db.Uuid
  categoryId String   @db.Uuid
  creatorId  String
  staffIds   String[]
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())
}

/// Funk-Codes (z. B. „10-4 = Verstanden“) – je Discord-Server oder für alle Server (guildId null).
model RadioCode {
  id          String   @id @default(uuid()) @db.Uuid
  guildId     String?
  code        String
  meaning     String
  category    String?
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([guildId, code])
  @@index([guildId, position])
}

// ───────────── ER:LC-Integration & CAD ─────────────

/// Verbundener ER:LC-Privatserver. Der Server-Key liegt nur verschlüsselt hier (AES-256-GCM) und verlässt das Backend nie.
model ErlcServer {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  /// Optionale eigene Kennung (z. B. Join-Key) zur Anzeige
  serverRef      String?
  description    String?
  logoUrl        String?
  /// zugehöriger Discord-Server
  guildId        String?
  active         Boolean             @default(true)
  keyCipher      String
  pollSeconds    Int                 @default(15)
  /// Erlaubte Funktionen: players, staff, queue, vehicles, emergencyCalls, modCalls, joinLogs, killLogs, commandLogs, commands, webhook
  features       String[]            @default([])
  webhookEnabled Boolean             @default(false)
  /// Geheimer Teil der Webhook-Adresse (bindet signierte PRC-Zustellungen an genau diesen Server)
  webhookToken   String              @default(dbgenerated("md5(((random())::text || (clock_timestamp())::text))"))
  /// API-Einstellungen (z. B. kritische/gesperrte Befehle, Timeout)
  settings       Json?
  status         String              @default("UNKNOWN") // CONNECTED | LIMITED | OFFLINE | ERROR | UNKNOWN | DISABLED
  lastSyncAt     DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  latencyMs      Int?
  rateLimit      Json?
  /// Letzter erfolgreicher Datenstand (ohne Zugangsdaten) – bleibt bei API-Ausfall sichtbar
  snapshot       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  calls          ErlcEmergencyCall[]
  commands       ErlcCommandLog[]
}

/// Notruf aus ER:LC (API oder Webhook). Verknüpfung mit einem CAD-Einsatz über incidentId.
model ErlcEmergencyCall {
  id                 String     @id @default(uuid()) @db.Uuid
  serverId           String     @db.Uuid
  callNumber         Int
  team               String?
  callerRobloxId     String?
  callerName         String?
  description        String?
  positionDescriptor String?
  mapX               Float?
  mapZ               Float?
  startedAt          DateTime
  status             String     @default("OPEN") // OPEN | CLAIMED | CLOSED
  claimedById        String?    @db.Uuid
  incidentId         String?    @db.Uuid
  source             String     @default("API") // API | WEBHOOK
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  server             ErlcServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, callNumber, startedAt])
  @@index([status, startedAt])
}

/// Protokoll des Command Centers (jeder ausgeführte ER:LC-Befehl).
model ErlcCommandLog {
  id        String     @id @default(uuid()) @db.Uuid
  serverId  String     @db.Uuid
  userId    String?    @db.Uuid
  discordId String?
  command   String
  critical  Boolean    @default(false)
  ok        Boolean
  result    String?
  error     String?
  createdAt DateTime   @default(now())
  server    ErlcServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

/// Eigene Kartenobjekte: POI (Punkt) oder Zone (Polygon). Koordinaten in ER:LC-Spielkoordinaten (unabhängig vom Kartenbild).
model CadMapObject {
  id           String   @id @default(uuid()) @db.Uuid
  kind         String // POI | ZONE
  name         String
  description  String?
  category     String?
  /// Layer-Schlüssel (z. B. pois, zones, restricted oder eigener Layer)
  layer        String
  icon         String?
  color        String?
  x            Float?
  z            Float?
  points       Json?
  /// sichtbar für alle (leer) oder nur für diese Discord-Rollen
  roleIds      String[] @default([])
  incidentType String?
  autoAction   String?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([layer])
}

/// Chronik eines Einsatzes: Funkmeldungen, Statuswechsel, Zuweisungen, Notizen, Notruf-Verknüpfungen.
model CadIncidentLog {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  kind       String // RADIO | STATUS | ASSIGN | NOTE | CALL | CREATED
  text       String
  unitId     String?  @db.Uuid
  authorId   String?  @db.Uuid
  guildId    String?
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

/// Funkmeldung (Funk-Integration). Mit incidentId landet sie zusätzlich in der Einsatzchronik.
model CadRadioMessage {
  id         String   @id @default(uuid()) @db.Uuid
  callsign   String?
  unitId     String?  @db.Uuid
  incidentId String?  @db.Uuid
  text       String
  authorId   String?  @db.Uuid
  discordId  String?
  guildId    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Zuordnung Discord ↔ Roblox ↔ ER:LC ↔ Team ↔ Einheit, plus Funk-Benutzerdaten (Zello, Funkrufname, Abteilung, Rang).
model CadMember {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @unique @db.Uuid
  discordId   String?  @unique
  discordName String?
  robloxName  String?
  robloxId    String?
  erlcName    String?
  team        String?
  unitId      String?  @db.Uuid
  zelloName   String?
  callsign    String?
  department  String?
  rank        String?
  /// zusätzliche, im Dashboard konfigurierte Felder
  extra       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([erlcName])
}

/// Verbindung zwischen zwei Discord-Servern (z. B. Leitstelle ↔ SEK/K9): welche Daten/Aktionen erlaubt sind.
model CadServerLink {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  sourceGuildId String
  targetGuildId String
  active        Boolean  @default(true)
  /// Datenarten, die die Quelle an das Ziel senden darf (incidents, incident_status, unit_requests, calls, announcements)
  sendTypes     String[] @default([])
  /// Aktionen, die das Ziel zurück an die Quelle ausführen darf (status_report, radio, view_incidents)
  allowActions  String[] @default([])
  /// Rollen auf dem Ziel-Server, die diese Aktionen ausführen dürfen (leer = alle mit passendem cad-Recht)
  roleIds       String[] @default([])
  /// Zielkanäle je Datenart: { "incidents": ["<channelId>"], ... }
  channels      Json?
  notify        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([sourceGuildId, targetGuildId])
}

// ───────────── Datensatz-Sperre beim Bearbeiten ─────────────

/// Wer gerade einen Datensatz bearbeitet. Läuft ohne Lebenszeichen nach kurzer Zeit ab.
model EditLock {
  entityType String
  entityId   String   @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@id([entityType, entityId])
  @@index([userId])
}

// ───────────── Studio-Workflows ─────────────

/// „Wenn <Audit-Ereignis> (und Bedingungen) → Aktionen“. Wirkt nur auf Ereignisse ab `activeSince`.
model Workflow {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  enabled     Boolean       @default(true)
  trigger     String
  conditions  Json          @default("[]")
  actions     Json          @default("[]")
  activeSince DateTime      @default(now())
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        WorkflowRun[]
}

/// Jede Ausführung (einmal je Workflow und Audit-Eintrag).
model WorkflowRun {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  auditId    String   @db.Uuid
  action     String
  entityId   String?
  ok         Boolean  @default(true)
  error      String?
  createdAt  DateTime @default(now())

  @@unique([workflowId, auditId])
  @@index([workflowId, createdAt])
}

/// Sprach-Support: ein Fall entsteht, wenn jemand einen Warteraum betritt (Räume: SystemSetting `voice-support.rooms`).
model VoiceSupportCase {
  id              String    @id @default(uuid()) @db.Uuid
  number          String    @unique
  roomId          String
  roomName        String
  guildId         String
  userId          String // Discord-ID der hilfesuchenden Person
  userName        String
  status          String    @default("WAITING") // WAITING | CLAIMED | DECLINED | ABANDONED | CLOSED
  claimedById     String?
  claimedByName   String?
  claimedAt       DateTime?
  closedById      String?
  closedByName    String?
  closedAt        DateTime?
  closeReason     String?
  channelId       String? // Sprachkanal des Falls
  createdChannel  Boolean   @default(false) // vom Bot angelegt → wird beim Schließen gelöscht
  notifyChannelId String?
  notifyMessageId String?
  threadId        String?
  messages        Int       @default(0)
  rating          Int?
  createdAt       DateTime  @default(now())

  @@index([guildId, status])
  @@index([userId, status])
  @@index([channelId])
}
