generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Identity & RBAC ─────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  displayName        String
  email              String?   @unique
  passwordHash       String
  robloxUserId       String?   @unique
  robloxUsername     String?
  robloxStatus       String    @default("UNVERIFIED") // UNVERIFIED | VERIFIED | FAILED | MANUAL
  robloxVerifiedAt   DateTime?
  robloxVerifiedById String?   @db.Uuid
  active             Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLogin          DateTime?
  /// Zwei-Faktor (TOTP): Geheimnis verschlüsselt; aktiv ab totpEnabledAt. Wiederherstellungscodes nur als SHA-256.
  totpSecret         String?
  totpPending        String?
  totpEnabledAt      DateTime?
  totpLastStep       Int?
  totpRecovery       String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)

  roles         UserRole[]
  groups        GroupMember[]
  overrides     UserPermissionOverride[]
  sessions      Session[]
  loginHistory  LoginHistory[]
  notifications Notification[]
  /// je Server eine eigene Personalakte
  personnel     Personnel[]
  dutySessions  DutySession[]
  leaveRequests LeaveRequest[]
  settings      UserSettings?
  editLocks     EditLock[]
  dutyReports   DutyReport[]             @relation("DutyReportAuthor")
  memberships   ServerMembership[]

  @@index([robloxUsername])
}

model Role {
  id              String               @id @default(uuid()) @db.Uuid
  /// eindeutig je Server (`guildId`); serverübergreifende Rollen (guildId null) zusätzlich per Teil-Index eindeutig
  name            String
  description     String?
  system          Boolean              @default(false)
  /// Rang in der Hierarchie: kleiner = höher (1 = Serverbesitzer). Nur Rollen unterhalb der eigenen dürfen verwaltet werden.
  priority        Int                  @default(100)
  color           String?
  icon            String?
  /// Deaktivierte Rollen verleihen keine Rechte (bleiben aber zugewiesen).
  active          Boolean              @default(true)
  /// Discord-Rollen, die diese Dashboard-Rolle automatisch verleihen (Abgleich bei Login und regelmäßig).
  discordRoleIds  String[]             @default([])
  /// Discord-Server, auf dem die Rolle gilt (null = alle Server). Server laufen getrennt.
  guildId         String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  users           UserRole[]
  permissions     RolePermission[]
  discordMappings DiscordRoleMapping[]

  @@unique([guildId, name])
  @@index([name])
}

model Permission {
  key         String                   @id // z. B. "dispatch.view"
  module      String
  description String?
  roles       RolePermission[]
  overrides   UserPermissionOverride[]
}

model UserRole {
  userId   String   @db.Uuid
  roleId   String   @db.Uuid
  /// Leer = manuell vergeben (gilt überall, wo die Rolle gilt). Sonst über Discord-Rollen vergeben und NUR auf diesen Servern gültig.
  guildIds String[] @default([])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId        String     @db.Uuid
  permissionKey String
  effect        String     @default("ALLOW") // ALLOW | DENY
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model Group {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  description String?
  members     GroupMember[]
  roles       GroupRole[]
}

model GroupRole {
  groupId String @db.Uuid
  roleId  String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, roleId])
}

model GroupMember {
  groupId String @db.Uuid
  userId  String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model UserPermissionOverride {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  /// Server, auf dem die Ausnahme gilt; null = nur unter „Alle Server“
  guildId       String?
  permissionKey String
  effect        String // ALLOW | DENY
  reason        String?
  createdById   String?    @db.Uuid
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([userId, guildId, permissionKey])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  username  String
  success   Boolean
  reason    String?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([username, createdAt])
}

model UserSettings {
  userId          String @id @db.Uuid
  theme           String @default("dark")
  timezone        String @default("Europe/Berlin")
  dashboardLayout Json?
  notifications   Json?
  /// Persönliches Design, Favoriten, Schnellzugriff, Benachrichtigungen, Ansichten (nur für den Benutzer selbst)
  preferences     Json?
  /// Mehrere persönliche Startseiten-Layouts mit Widgets
  layouts         Json?
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── Records ─────────────

model Person {
  id             String    @id @default(uuid()) @db.Uuid
  serverId       String?   @db.Uuid
  robloxUserId   String? // eindeutig je Akten-Bereich (serverId), siehe Server-Verbund
  robloxUsername String
  aliases        String[]  @default([])
  status         String    @default("ACTIVE") // ACTIVE | ARCHIVED
  notes          String?
  custom         Json? // Werte der in Studio definierten Custom Fields
  /// Personalien im MDT (Rollenspiel-Identität); Lizenzen/Merkmale sind Schlüssel aus der MDT-Konfiguration
  fullName       String?
  dateOfBirth    DateTime? @db.Date
  gender         String?
  phone          String?
  job            String?
  nationality    String?
  address        String?
  appearance     Json?
  licenses       String[]  @default([])
  flags          String[]  @default([])
  /// Foto (Media mit linkedType „Person“)
  photoId        String?   @db.Uuid
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  vehicles Vehicle[]
  weapons  Weapon[]
  links    RecordLink[]
  tickets  Ticket[]

  @@unique([serverId, robloxUserId])
  @@index([robloxUsername])
}

model Vehicle {
  id            String   @id @default(uuid()) @db.Uuid
  serverId      String?  @db.Uuid
  plate         String
  model         String?
  color         String?
  ownerId       String?  @db.Uuid
  status        String   @default("ACTIVE")
  erlcReference String?
  notes         String?
  custom        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)
  owner         Person?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([serverId, plate])
  @@index([plate])
}

/// Waffenregister im MDT: Seriennummer je Akten-Bereich eindeutig.
model Weapon {
  id        String   @id @default(uuid()) @db.Uuid
  serverId  String?  @db.Uuid
  serial    String
  type      String
  model     String?
  ownerId   String?  @db.Uuid
  status    String   @default("REGISTERED") // REGISTERED | STOLEN | SEIZED | DESTROYED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  owner     Person?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([serverId, serial])
  @@index([serial])
  @@index([ownerId])
}

/**
 * Generische, dedupe-sichere Verknüpfung Datensatz <-> Person/Fahrzeug.
 */
model RecordLink {
  id         String   @id @default(uuid()) @db.Uuid
  personId   String?  @db.Uuid
  vehicleId  String?  @db.Uuid
  entityType String
  entityId   String
  role       String   @default("SUBJECT") // SUBJECT | SUSPECT | WITNESS | VICTIM | ...
  createdAt  DateTime @default(now())
  person     Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, entityType, entityId, role])
  @@index([entityType, entityId])
}

model LegalCode {
  id            String    @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId      String?   @db.Uuid
  code          String
  title         String
  description   String?
  category      String
  penalty       Json
  active        Boolean   @default(true)
  effectiveDate DateTime  @default(now())
  expiresAt     DateTime?
  tickets       Ticket[]

  @@unique([serverId, code])
}

model Ticket {
  id          String     @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId    String?    @db.Uuid
  number      String     @unique
  personId    String     @db.Uuid
  officerId   String     @db.Uuid
  legalCodeId String?    @db.Uuid
  reason      String
  amount      Decimal    @default(0) @db.Decimal(12, 2)
  status      String     @default("ISSUED")
  notes       String?
  reportId    String?    @db.Uuid
  voidReason  String?
  voidedById  String?    @db.Uuid
  issuedAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  version     Int        @default(1)
  person      Person     @relation(fields: [personId], references: [id])
  legalCode   LegalCode? @relation(fields: [legalCodeId], references: [id])

  @@index([personId])
  @@index([officerId])
  @@index([serverId])
}

model Unit {
  id            String         @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId      String?        @db.Uuid
  callsign      String
  status        String         @default("OFF_DUTY")
  vehicle       String?
  notes         String?
  /// CAD: Anzeigename, Einheitentyp (Schlüssel aus der CAD-Konfiguration, z. B. SEK/K9), Darstellung, Zuordnung
  name          String?
  type          String?
  color         String?
  icon          String?
  discordRoleId String?
  /// Discord-Server, zu dem die Einheit gehört (z. B. SEK/K9-Server)
  guildId       String?
  erlcTeam      String?
  operational   Boolean        @default(true)
  /// Manuell gesetzte Kartenposition (ER:LC-Koordinaten), falls kein verknüpfter Spieler im Spiel ist
  mapX          Float?
  mapZ          Float?
  /// Discord-Rollen, die den Status dieser Einheit melden dürfen (zusätzlich zu Leitstelle, Besatzung und discordRoleId)
  statusRoleIds String[]       @default([])
  members       UnitMember[]
  incidents     IncidentUnit[]
  updatedAt     DateTime       @updatedAt

  @@unique([serverId, callsign])
}

model UnitMember {
  unitId String @db.Uuid
  userId String @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([unitId, userId])
}

model Incident {
  id              String           @id @default(uuid()) @db.Uuid
  serverId        String?          @db.Uuid
  number          String           @unique
  title           String
  description     String?
  priority        String           @default("MEDIUM")
  location        String?
  source          String           @default("MANUAL") // MANUAL
  status          String           @default("NEW")
  dispatcherId    String?          @db.Uuid
  supervisorId    String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  closedAt        DateTime?
  version         Int              @default(1)
  units           IncidentUnit[]
  /// CAD-Felder: Einsatzart, Stichwort, Kartenposition (ER:LC-Koordinaten), Beteiligte, benötigte Einheiten, interne Notizen
  type            String?
  keyword         String?
  mapX            Float?
  mapZ            Float?
  involved        String?
  requiredUnits   String?
  internalNotes   String?
  /// Discord-Server, auf dem der Einsatz geführt wird (Leitstelle)
  guildId         String?
  /// Vertraulich: nur diese Dashboard-Rollen (und CAD-Verwaltung/Disponent) sehen den Einsatz; leer = alle mit cad.view
  restrictRoleIds String[]         @default([])
  log             CadIncidentLog[]

  @@index([status, priority])
  @@index([serverId])
}

model IncidentUnit {
  incidentId String    @db.Uuid
  unitId     String    @db.Uuid
  assignedAt DateTime  @default(now())
  clearedAt  DateTime?
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([incidentId, unitId])
}

model Report {
  id             String          @id @default(uuid()) @db.Uuid
  serverId       String?         @db.Uuid
  number         String          @unique
  type           String
  title          String
  status         String          @default("DRAFT")
  authorId       String          @db.Uuid
  incidentId     String?         @db.Uuid
  currentVersion Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  version        Int             @default(1)
  versions       ReportVersion[]

  @@index([status])
  @@index([serverId])
}

model ReportVersion {
  id            String   @id @default(uuid()) @db.Uuid
  reportId      String   @db.Uuid
  version       Int
  authorId      String   @db.Uuid
  changeSummary String
  content       Json
  contentHash   String
  createdAt     DateTime @default(now())
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, version])
}

model Complaint {
  id             String   @id @default(uuid()) @db.Uuid
  serverId       String?  @db.Uuid
  number         String   @unique
  complainantId  String?  @db.Uuid
  subjectId      String?  @db.Uuid
  officerId      String?  @db.Uuid
  category       String
  description    String
  status         String   @default("RECEIVED")
  investigatorId String?  @db.Uuid
  findings       String?
  resolution     String?
  internalNotes  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  version        Int      @default(1)

  @@index([status])
  @@index([serverId])
}

model Investigation {
  id          String   @id @default(uuid()) @db.Uuid
  serverId    String?  @db.Uuid
  caseNumber  String   @unique
  title       String
  description String?
  leadId      String?  @db.Uuid
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@index([serverId])
}

model WantedRecord {
  id          String          @id @default(uuid()) @db.Uuid
  /// Fahndungsnummer (z. B. F-2026-K7M2QX); ältere Einträge bekommen sie per Migration
  number      String?         @unique
  serverId    String?         @db.Uuid
  personId    String?         @db.Uuid
  vehicleId   String?         @db.Uuid
  reason      String
  description String?
  priority    String          @default("MEDIUM")
  status      String          @default("ACTIVE")
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())
  expiresAt   DateTime?
  updatedAt   DateTime        @updatedAt
  version     Int             @default(1)
  hits        ErlcWantedHit[]

  @@index([status])
  @@index([serverId])
}

model Evidence {
  id              String             @id @default(uuid()) @db.Uuid
  serverId        String?            @db.Uuid
  number          String             @unique
  caseRef         String?
  type            String
  description     String
  source          String?
  ownerId         String?            @db.Uuid
  storageLocation String?
  custodyState    String             @default("COLLECTED")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  version         Int                @default(1)
  transfers       EvidenceTransfer[]

  @@index([serverId])
}

model EvidenceTransfer {
  id         String   @id @default(uuid()) @db.Uuid
  evidenceId String   @db.Uuid
  fromUserId String?  @db.Uuid
  toUserId   String?  @db.Uuid
  fromState  String
  toState    String
  reason     String
  confirmed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
}

// ───────────── Personnel / Dienst ─────────────

model Personnel {
  id                 String               @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId           String?              @db.Uuid
  userId             String               @db.Uuid
  rank               String?
  team               String?
  callsign           String?
  /// Büro (Liste unter Einstellungen → Teamstruktur)
  office             String?
  /// Dienstnummer
  serviceNumber      String?
  employmentStatus   String               @default("ACTIVE")
  joinDate           DateTime             @default(now())
  qualifications     String[]             @default([])
  /// seit wann im aktuellen Rang (Beförderungsvoraussetzung „Mindestzeit im Rang“)
  rankSince          DateTime             @default(now())
  /// abgehakte frei definierte Voraussetzungen { <Voraussetzungs-ID>: true }
  customChecks       Json                 @default("{}")
  updatedAt          DateTime             @default(now()) @updatedAt
  hrRequests         HrRequest[]
  trainingProgress   HrTrainingProgress[]
  examAttempts       HrExamAttempt[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  academyEnrollments AcademyEnrollment[]
  records            PersonnelRecord[]

  @@unique([serverId, userId])
  @@unique([serverId, callsign])
  @@unique([serverId, serviceNumber])
}

/// Beförderungen, Auszeichnungen, Disziplinarmaßnahmen (nur mit personnel.* sichtbar).
model PersonnelRecord {
  id          String    @id @default(uuid()) @db.Uuid
  personnelId String    @db.Uuid
  type        String // PROMOTION | TRANSFER | AWARD | WARNING | DISCIPLINE | NOTE | RECOMMENDATION | SERVICE_NUMBER | STATUS | TRAINING | EXAM
  summary     String
  details     String?
  /// strukturierte Angaben je Art (z. B. Beförderung: from/to/Antragsteller/Genehmiger; Verwarnung: Kategorie/Schweregrad)
  data        Json?
  /// z. B. Verwarnung ACTIVE | EXPIRED | REVOKED
  status      String?
  expiresAt   DateTime?
  attachments String[]  @default([])
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  /// weich gelöscht (nur mit Recht; bleibt im Audit nachvollziehbar)
  deletedAt   DateTime?
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@index([personnelId, createdAt])
  @@index([type, createdAt])
}

model DutySession {
  id             String    @id @default(uuid()) @db.Uuid
  serverId       String?   @db.Uuid
  userId         String    @db.Uuid
  status         String
  unitId         String?   @db.Uuid
  callsign       String?
  /// Schicht-Art (Admin → Shifts), z. B. „Im Dienst“
  shiftType      String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  /// Letzte echte Aktivität (Dashboard/MDT, Discord-Befehle) – für die Inaktivitäts-Erinnerung
  lastActivityAt DateTime?
  /// Wann zuletzt an die laufende Schicht erinnert wurde
  remindedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
  @@index([serverId])
}

/// Wochenarchiv des automatischen Wochen-Resets (Montag 00:00 Europe/Berlin): Rangliste + alle Dienstzeiten der Woche als Momentaufnahme.
/// Unveränderlich (DB-Trigger verbietet UPDATE/DELETE/TRUNCATE); `weekStart` eindeutig → ein Archiv und eine Discord-Meldung je Woche.
model DutyWeekArchive {
  id               String   @id @default(uuid()) @db.Uuid
  /// Bereich: `global` (Gesamtstatistik aller Server) oder `space:<Akten-Bereich>` (Server bzw. gemeinsame Shift-Log-Gruppe)
  scope            String   @default("global")
  /// Montag 00:00 der archivierten Woche (als UTC-Zeitpunkt)
  weekStart        DateTime
  /// folgender Montag 00:00 (exklusiv)
  weekEnd          DateTime
  /// lokales Datum des Montags, z. B. 2026-10-05
  weekKey          String
  label            String
  timezone         String
  totalMinutes     Int
  activeUsers      Int
  shiftCount       Int
  /// Rangliste: [{ place, userId, name, rank, callsign, discordId, minutes, breakMinutes, byStatus, sessions }]
  ranking          Json
  /// alle Dienst-Sitzungen der Woche (an den Wochengrenzen abgeschnitten)
  sessions         Json
  /// Discord-Kanal der Rangliste; null = nicht veröffentlicht (kein Kanal, aus oder nachgeholte ältere Woche)
  discordChannelId String?
  /// nach einem Neustart nachgeholt
  catchUp          Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([scope, weekStart])
  @@index([createdAt])
}

/// Abmeldung (Leave of Absence): Antrag → Freigabe → Rolle „abgemeldet“ von Beginn bis Ende.
model LeaveRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  number               String    @unique
  userId               String    @db.Uuid
  startsAt             DateTime
  endsAt               DateTime
  reason               String
  status               String    @default("PENDING") // PENDING | APPROVED | DENIED | CANCELLED | ENDED
  guildId              String?
  decidedById          String?   @db.Uuid
  decidedAt            DateTime?
  decisionReason       String?
  /// Abwesenheitsart (Einstellungen → Personal), z. B. Urlaub, Krank
  type                 String?
  comment              String?
  roleApplied          Boolean   @default(false)
  endedAt              DateTime?
  /// offene Verlängerung (beantragt vom Mitglied, wartet auf die Leitung)
  extensionMinutes     Int?
  extensionReason      String?
  extensionRequestedAt DateTime?
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, startsAt])
  @@index([userId])
}

model Application {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique
  status         String    @default("SUBMITTED")
  answers        Json
  grantRoleIds   String[]  @default([]) // Discord-Rollen aus Rollen-Auswahl-Fragen, vergeben bei Annahme
  guildId        String? // Discord-Server, auf dem die Bewerbung gestartet wurde
  robloxUsername String
  robloxUserId   String?
  decidedById    String?   @db.Uuid
  /// Zeitpunkt der Annahme/Ablehnung (für die Statistik)
  decidedAt      DateTime?
  discordId      String? // Bewerber-Discord-ID (bei Bewerbung über den Bot) – für die Entscheidungs-DM
  discordName    String?
  source         String    @default("WEB") // WEB | DISCORD
  durationSec    Int? // Dauer der Bewerbung im Discord-Chat
  joinedAt       DateTime? // Beitritt zum Discord-Server
  decisionReason String? // Begründung für den Bewerber (Discord „… mit Grund“), geht per DM raus
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  @@index([status])
}

/// Persönliche Erinnerung (`/remind-me`): dauerhaft gespeichert, damit sie Neustarts übersteht. Fällige werden genau einmal
/// (atomar) in die Bot-Warteschlange gelegt; Verschieben setzt sie wieder auf PENDING.
model Reminder {
  id        String    @id @default(uuid()) @db.Uuid
  discordId String
  guildId   String?
  /// Kanal, in dem `/remind-me` benutzt wurde (Zustellung ohne DM bzw. Ersatz, wenn die DM nicht ankommt)
  channelId String?
  text      String
  dm        Boolean   @default(false)
  dueAt     DateTime
  /// PENDING | SENT | DONE | CANCELLED
  status    String    @default("PENDING")
  /// wie oft schon ausgelöst – schützt Buttons vor doppelten Klicks
  fireCount Int       @default(0)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, dueAt])
  @@index([discordId, status])
}

/// KI-Bewerbungsprüfung (Gemini o. Ä.): je Analyse eine Zeile, eindeutig der Bewerbung zugeordnet. Nur Entscheidungshilfe –
/// ändert nie den Status der Bewerbung. Dashboard und Discord lesen dieselben Zeilen.
model ApplicationAiReview {
  id              String    @id @default(uuid()) @db.Uuid
  /// POLICE (Application) | QUALIFICATION (QualificationApplication)
  kind            String
  applicationId   String    @db.Uuid
  guildId         String?
  /// RUNNING | DONE | FAILED
  status          String    @default("RUNNING")
  /// Fingerabdruck der übermittelten Fragen/Antworten/Regeln – anders als heute = Ergebnis evtl. veraltet
  inputHash       String
  provider        String
  model           String?
  /// geprüftes Ergebnis (siehe aiReviewResultSchema), nur bei DONE
  result          Json?
  /// verständliche Fehlermeldung (ohne Bewerbungstext, ohne Schlüssel)
  error           String?
  /// Eingabe wurde wegen der Länge gekürzt
  truncated       Boolean   @default(false)
  requestedById   String?   @db.Uuid
  requestedByName String?
  /// WEB (Dashboard) | DISCORD (Button)
  via             String    @default("WEB")
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([kind, applicationId, createdAt])
  @@index([createdAt])
}

/// Angefangene, noch nicht eingereichte Bewerbung (Fragen per DM oder Link zum Web-Formular) – Anzeige „in Bearbeitung“ im Dashboard
model ApplicationProgress {
  id          String   @id @default(uuid()) @db.Uuid
  discordId   String
  discordName String
  /// `@polizei` (Polizei-Bewerbung) oder Schlüssel der Einheit / Bewerbungsart
  unit        String
  unitName    String
  guildId     String?
  source      String   @default("DISCORD") // DISCORD (Fragen per Direktnachricht) | WEB (Link zum Formular)
  /// beantwortete Fragen / Fragen insgesamt (nur bei Bewerbung per Direktnachricht bekannt)
  answered    Int?
  total       Int?
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime

  @@unique([discordId, unit])
  @@index([expiresAt])
}

model AcademyCourse {
  id           String              @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId     String?             @db.Uuid
  title        String
  description  String?
  passScore    Int                 @default(70)
  instructorId String?             @db.Uuid
  enrollments  AcademyEnrollment[]

  @@index([serverId])
}

model AcademyEnrollment {
  id          String          @id @default(uuid()) @db.Uuid
  courseId    String          @db.Uuid
  personnelId String          @db.Uuid
  createdAt   DateTime        @default(now())
  course      AcademyCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  personnel   Personnel       @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  results     AcademyResult[]

  @@unique([courseId, personnelId])
}

model AcademyResult {
  id           String            @id @default(uuid()) @db.Uuid
  enrollmentId String            @db.Uuid
  score        Int
  passed       Boolean
  gradedById   String?           @db.Uuid
  createdAt    DateTime          @default(now())
  enrollment   AcademyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

// ───────────── Kommunikation ─────────────

model Conversation {
  id       String    @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId String?   @db.Uuid
  channel  String // TEAM | DISPATCH | INCIDENT | SUPERVISOR | ANNOUNCEMENT
  title    String?
  entityId String?
  messages Message[]

  @@index([serverId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  authorId       String       @db.Uuid
  body           String
  replyToId      String?      @db.Uuid
  pinned         Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Media {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String
  mime         String
  size         Int
  hash         String
  storageKey   String   @unique
  uploaderId   String   @db.Uuid
  linkedType   String?
  linkedId     String?
  createdAt    DateTime @default(now())

  @@index([linkedType, linkedId])
}

// ───────────── Timeline & Audit ─────────────

/**
 * Operative Historie (sichtbar für Fachanwender).
 */
model TimelineEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String
  action     String
  summary    String
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

/**
 * Technische Nachvollziehbarkeit. Append-only; durch DB-Trigger gegen UPDATE/DELETE geschützt.
 */
model AuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  actorUserId       String?  @db.Uuid
  /// Discord-Server der Aktion (Guild-ID), sofern anwendbar
  serverId          String?
  /// SUCCESS | DENIED | FAILED
  result            String   @default("SUCCESS")
  actorRobloxUserId String?
  action            String
  module            String
  entityType        String?
  entityId          String?
  before            Json?
  after             Json?
  reason            String?
  requestId         String?
  createdAt         DateTime @default(now())

  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([serverId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String // LOGIN_FAILURE | PERMISSION_DENIED | WEBHOOK_FAILURE | INVALID_TOKEN | RATE_LIMIT | SUSPICIOUS
  userId    String?  @db.Uuid
  ip        String?
  detail    String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────── Discord-Bot ─────────────

/// Verknüpfung Discord-Konto ↔ Systembenutzer. Alle Bot-Befehle laufen mit den Rechten dieses Benutzers.
model DiscordLink {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  discordId      String    @unique
  linkedAt       DateTime  @default(now())
  /// Discord-Server, die der Benutzer verwalten darf ({ id, name, icon }[], beim Discord-Login) – nur für „Bot einladen“
  managedGuilds  Json?
  guildsSyncedAt DateTime?
}

/// Einmal-Code zum Verknüpfen (nur der Hash wird gespeichert, 10 Minuten gültig, einmal verwendbar).
model DiscordLinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Ausgangs-Warteschlange für Discord-Nachrichten (Bot holt ab und quittiert).
model DiscordOutbox {
  id         String    @id @default(uuid()) @db.Uuid
  type       String
  channelKey String // dispatch | wanted | announcements
  payload    Json
  attempts   Int       @default(0)
  lastError  String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([sentAt, createdAt])
}

/// Funk-Freigabe (Whitelist): nur freigegebene Mitglieder gelten als funkberechtigt.
model RadioWhitelist {
  id        String   @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId  String?  @db.Uuid
  userId    String   @db.Uuid
  addedById String?  @db.Uuid
  createdAt DateTime @default(now())

  @@unique([serverId, userId])
}

/**
 * Funk-Whitelist (externer Funkdienst): wer für den Funkdienst freigeschaltet ist. Identifikation ausschließlich über die
 * Discord-ID (nie über den Namen). Ein Eintrag je Mitglied; „Entfernen“ archiviert (archivedAt), gelöscht wird nie.
 * Löst die frühere Tabelle RadioWhitelist ab (bleibt als Altbestand unverändert erhalten, siehe docs/radio-whitelist.md).
 */
model RadioGrant {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Eindeutige Discord-ID; nur bei übernommenen Alt-Einträgen ohne verknüpftes Discord-Konto leer (muss nachgetragen werden)
  discordId           String?   @unique
  /// Zuletzt bekannter Discord-Anzeigename (nur Anzeige, nie zur Identifikation)
  discordName         String?
  /// verknüpftes Dashboard-Konto (optional)
  userId              String?   @db.Uuid
  rank                String?
  department          String?
  /// Benutzername beim externen Funkdienst (z. B. Zello)
  externalName        String?
  /// PENDING | ACTIVE | DISABLED | SUSPENDED | EXPIRED | REVOKED
  status              String    @default("ACTIVE")
  /// MANUAL | ROLE | REQUEST | LEGACY
  source              String    @default("MANUAL")
  reason              String?
  expiresAt           DateTime?
  suspendedUntil      DateTime?
  suspendReason       String?
  /// Status vor der Sperre (nach Ablauf/Aufhebung zurück)
  statusBeforeSuspend String?
  /// true = zuletzt durch den Discord-Rollenabgleich deaktiviert/entzogen (darf bei Rollengewinn wieder aktiviert werden)
  roleRevoked         Boolean   @default(false)
  grantedById         String?   @db.Uuid
  grantedAt           DateTime?
  archivedAt          DateTime?
  /// NONE | PENDING | SYNCED | FAILED | MANUAL (nur manuell möglich) | MANUAL_DONE
  externalStatus      String    @default("NONE")
  externalSyncedAt    DateTime?
  externalError       String?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([expiresAt])
  @@index([userId])
}

/**
 * Antrag auf Funkfreigabe (über Discord gestellt). Entscheidungen werden nie gelöscht.
 */
model RadioRequest {
  id             String    @id @default(uuid()) @db.Uuid
  discordId      String
  discordName    String?
  guildId        String?
  rank           String?
  department     String?
  reason         String
  /// Antworten auf eigene Formularfelder ([{ key, label, value }], im Dashboard festgelegt)
  answers        Json?
  /// PENDING | APPROVED | REJECTED | WITHDRAWN
  status         String    @default("PENDING")
  decidedById    String?   @db.Uuid
  decidedAt      DateTime?
  decisionReason String?
  /// Ablaufdatum der Freigabe bei Genehmigung (optional)
  grantExpiresAt DateTime?
  grantId        String?   @db.Uuid
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([discordId])
}

/**
 * Anbindung an den externen Funkdienst (genau eine Zeile, id = "default"). Zugangsdaten nur verschlüsselt
 * (AES-256-GCM, siehe cad/erlc-crypto.ts) – sie verlassen den Server nie.
 */
model RadioIntegration {
  id             String    @id @default("default")
  /// NONE | ZELLO_WORK (Server-API, verifiziert) | ZELLO_APP (kein API → manuell) | OTHER_MANUAL
  provider       String    @default("NONE")
  displayName    String    @default("Funkdienst")
  /// Zello Work: Netzwerkname (https://<netzwerk>.zellowork.com)
  network        String?
  /// Zello Work: Kanal, dem freigegebene Mitglieder hinzugefügt werden
  channel        String?
  adminUsername  String?
  passwordEnc    String?
  apiKeyEnc      String?
  /// automatische Synchronisierung bei Änderungen (nur mit unterstützter API)
  autoSync       Boolean   @default(false)
  /// NOT_CONFIGURED | CONNECTED | ERROR | MANUAL
  status         String    @default("NOT_CONFIGURED")
  lastTestAt     DateTime?
  lastSuccessAt  DateTime?
  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastError      String?
  version        Int       @default(1)
  updatedAt      DateTime  @updatedAt
}

/**
 * SEK (Spezialeinsatzkommando): eigenes Roster und eigene Einsatzberichte (Bewerbung: QualificationApplication).
 */
model SekMember {
  id        String   @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId  String?  @db.Uuid
  userId    String   @db.Uuid
  addedById String?  @db.Uuid
  createdAt DateTime @default(now())

  @@unique([serverId, userId])
}

model SekReport {
  id          String   @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId    String?  @db.Uuid
  number      String   @unique
  authorId    String   @db.Uuid
  occurredAt  DateTime
  missionType String
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([serverId])
}

/// Bewerbungssperre: Person (Discord-ID und/oder Roblox-ID) darf sich für bestimmte Bewerbungen nicht bewerben.
/// `scopes`: "*" = alle, "police" = Polizei-Bewerbung, sonst Schlüssel einer Qualifikation (z. B. "sek").
/// Je Discord-Server eigen (`guildId`); ohne Server = gilt überall.
model ApplicationBan {
  id            String    @id @default(uuid()) @db.Uuid
  guildId       String?
  discordId     String?
  robloxUserId  String?
  name          String
  scopes        String[]
  reason        String
  expiresAt     DateTime?
  createdById   String?   @db.Uuid
  createdByName String?
  createdAt     DateTime  @default(now())
  liftedAt      DateTime?
  liftedById    String?   @db.Uuid

  @@index([guildId])
  @@index([discordId])
  @@index([robloxUserId])
}

/**
 * Bewerbungen für Qualifikationen (SEK, Flugstaffel, Ausbilder …) – per Discord-Panel, Fragen einzeln per Direktnachricht.
 */
model QualificationApplication {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique
  unit           String
  unitName       String
  discordId      String
  discordName    String
  userId         String?   @db.Uuid
  answers        Json
  grantRoleIds   String[]  @default([]) // Discord-Rollen aus Rollen-Auswahl-Fragen, vergeben bei Annahme
  guildId        String? // Discord-Server, auf dem die Bewerbung gestartet wurde
  status         String    @default("OPEN")
  decidedById    String?   @db.Uuid
  decidedAt      DateTime?
  decisionReason String? // geht per DM an die Person
  durationSec    Int?
  joinedAt       DateTime?
  createdAt      DateTime  @default(now())

  @@index([discordId, status])
  @@index([status, createdAt])
}

// ================= Ticket-System (alles über das Dashboard konfigurierbar) =================

/**
 * Panel in einem Discord-Channel (Embed + Buttons oder Dropdown mit Ticket-Kategorien).
 */
model TicketPanel {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  guildId          String? // Discord-Server (leer = alle Server)
  title            String    @default("")
  description      String    @default("")
  emoji            String?
  color            Int       @default(3899638)
  thumbnailUrl     String?
  imageUrl         String?
  bannerUrl        String?
  footer           String?
  footerIconUrl    String?
  authorName       String?
  authorIconUrl    String?
  style            String    @default("BUTTONS") // BUTTONS | DROPDOWN
  placeholder      String    @default("Wähle eine Kategorie …")
  channelId        String? // Ziel-Channel für das Panel
  categoryIds      String[]  @db.Uuid // verfügbare Ticket-Arten in dieser Reihenfolge
  allowedRoleIds   String[] // Discord-Rollen, die dieses Panel benutzen dürfen (leer = alle)
  /// Ticketauslastung im Panel anzeigen (offene Tickets je Kategorie)
  showLoad         Boolean   @default(false)
  position         Int       @default(0)
  messageChannelId String?
  messageId        String?
  /// letzter Sende-/Aktualisierungsversuch in Discord (Fehlertext, falls fehlgeschlagen)
  publishedAt      DateTime?
  publishError     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/**
 * Abteilung (Zuständigkeit): Kategorien und Tickets werden einer Abteilung zugeordnet; ihre Discord-Rollen bearbeiten die Tickets.
 */
model TicketDepartment {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  description     String   @default("")
  emoji           String?
  /// zuständige Discord-Rollen (sehen + schreiben im Ticket-Kanal)
  staffRoleIds    String[]
  /// Leitung: Eskalationen/SLA-Überschreitungen werden hierhin gemeldet (bekommen dadurch KEINEN Zugriff)
  leadRoleIds     String[]
  /// Systemrollen, die Tickets dieser Abteilung im Dashboard sehen (leer = Kategorie-Regeln)
  accessRoleNames String[]
  /// interner Kanal für Benachrichtigungen dieser Abteilung (muss für Unbeteiligte unsichtbar sein)
  notifyChannelId String?
  active          Boolean  @default(true)
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/**
 * Versionen eines Ticket-Formulars – eingereichte Tickets behalten ihre Version und Antworten.
 */
model TicketFormVersion {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String   @db.Uuid
  version       Int
  fields        Json
  createdById   String?  @db.Uuid
  createdByName String?
  createdAt     DateTime @default(now())

  @@unique([categoryId, version])
}

/**
 * Angefangenes Discord-Formular (mehrere Schritte), bevor das Ticket entsteht. Eine Einreichung erzeugt höchstens ein Ticket.
 */
model TicketDraft {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String   @db.Uuid
  panelId       String?  @db.Uuid
  guildId       String
  discordId     String
  discordName   String
  memberRoleIds String[]
  formVersion   Int
  step          Int      @default(0)
  values        Json     @default("{}")
  files         Json     @default("{}")
  ticketId      String?  @db.Uuid
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([discordId])
  @@index([expiresAt])
}

model TicketCategory {
  id                        String    @id @default(uuid()) @db.Uuid
  name                      String
  guildId                   String? // Discord-Server (leer = alle Server)
  description               String    @default("")
  emoji                     String?
  color                     Int       @default(3899638)
  buttonStyle               String    @default("secondary")
  position                  Int       @default(0)
  active                    Boolean   @default(true)
  discordCategoryId         String? // Discord-Kategorie für neue Ticket-Channels
  channelNameFormat         String    @default("ticket-{username}")
  staffRoleIds              String[] // zuständige Discord-Rollen (sehen + schreiben)
  extraRoleIds              String[] // zusätzliche Discord-Rollen (sehen + schreiben)
  accessRoleNames           String[] // Systemrollen, die diese Tickets im Dashboard sehen (leer = alle mit ticket.view)
  requiredRoleIds           String[] // Discord-Rollen, die zum Öffnen nötig sind (leer = alle)
  allowedUserIds            String[] // nur diese Discord-Benutzer dürfen öffnen (leer = alle)
  maxOpen                   Int       @default(1) // 0 = unbegrenzt
  cooldownMinutes           Int       @default(0)
  defaultPriorityId         String?   @db.Uuid
  questions                 Json      @default("[]")
  welcomeTitle              String    @default("🎫 {category}")
  welcomeMessage            String    @default("Hallo {user}!\n\nBeschreibe dein Anliegen so genau wie möglich. Ein Teammitglied kümmert sich schnellstmöglich darum.")
  mentionStaff              Boolean   @default(true)
  mentionText               String    @default("")
  buttons                   Json      @default("[]")
  claimMode                 String    @default("SINGLE") // SINGLE | MULTI | PRIMARY
  claimMessage              String    @default("👤 Bearbeiter: {staff}")
  claimNotifyStaff          Boolean   @default(false)
  creatorCanClose           Boolean   @default(true)
  closeReasonMode           String    @default("OPTIONAL") // NONE | OPTIONAL | REQUIRED
  closeReasonSource         String    @default("BOTH") // PRESET | CUSTOM | BOTH
  closeRemovesAccess        Boolean   @default(true)
  allowReopen               Boolean   @default(true)
  transcriptOnClose         Boolean   @default(true)
  transcriptChannelId       String?
  transcriptToUser          Boolean   @default(false)
  ratingEnabled             Boolean   @default(true)
  ratingQuestion            String    @default("Wie zufrieden warst du mit dem Support?")
  autoCloseMinutes          Int       @default(0) // 0 = aus
  autoCloseWarnMinutes      Int       @default(0) // Warnung so viele Minuten vorher (0 = keine)
  autoCloseMessage          String    @default("⏰ {user}, dieses Ticket wird bald wegen Inaktivität geschlossen. Schreib eine Nachricht, wenn du noch Hilfe brauchst.")
  deleteAfterMinutes        Int       @default(-1) // -1 = nie, 0 = sofort
  escalationRoleIds         String[]
  escalationPriorityId      String?   @db.Uuid
  escalationMessage         String    @default("🟠 Dieses Ticket wurde eskaliert. {staff}")
  /// wie GalaxyBot: Bild im Eröffnungs-Embed
  welcomeImageUrl           String?
  /// Auslastung: ab so vielen offenen Tickets gilt die Kategorie als voll (0 = aus)
  capacity                  Int       @default(0)
  /// Ersteller darf weitere Personen hinzufügen
  creatorCanAddUsers        Boolean   @default(false)
  /// Nach Übernahme in diese Discord-Kategorie verschieben (Claim-Kategorie)
  claimDiscordCategoryId    String?
  /// Nach Übernahme dürfen nur noch Bearbeiter, Ersteller und Zusatzrollen schreiben
  claimLocksChat            Boolean   @default(false)
  /// Auto-Claim, sobald ein Teammitglied schreibt
  autoClaimOnMessage        Boolean   @default(false)
  /// Auto-Unclaim nach so vielen Minuten Inaktivität (0 = aus)
  autoUnclaimMinutes        Int       @default(0)
  /// Auto-Team-Alert: Bearbeiter nach so vielen Minuten markieren, nach derselben Zeit freigeben (0 = aus)
  staffAlertMinutes         Int       @default(0)
  /// Close-Request: bestätigt der Ersteller, wird sofort geschlossen
  closeRequestCloses        Boolean   @default(true)
  /// zuständige Abteilung
  departmentId              String?   @db.Uuid
  /// vertraulich: nie ersatzweise für das allgemeine Team sichtbar, Details nicht in Log-Kanälen
  confidential              Boolean   @default(false)
  /// CHANNEL = Fragen nacheinander im Ticket (bisher) · MODAL = Discord-Formular vor dem Erstellen
  formMode                  String    @default("CHANNEL")
  formVersion               Int       @default(1)
  /// unzugewiesene Tickets nach so vielen Minuten an die Leitung melden (0 = aus)
  escalateUnassignedMinutes Int       @default(0)
  /// archiviert: nicht mehr wählbar und ausgeblendet; Tickets bleiben vollständig erhalten
  archivedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model TicketStatus {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  emoji        String  @default("")
  color        Int     @default(3899638)
  position     Int     @default(0)
  kind         String  @default("OPEN") // OPEN | CLOSED | ARCHIVED
  isDefault    Boolean @default(false) // neue / wieder geöffnete Tickets
  isClaimed    Boolean @default(false) // beim Übernehmen
  isEscalation Boolean @default(false) // beim Eskalieren
  isClose      Boolean @default(false) // beim Schließen
  /// feste Bedeutung (OPEN, CLAIMED, IN_PROGRESS, WAITING_USER, WAITING_INTERNAL, RESOLVED, ESCALATED, CLOSED, ARCHIVED)
  key          String? @unique
}

model TicketPriority {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  emoji                String   @default("")
  color                Int      @default(3899638)
  position             Int      @default(0)
  isDefault            Boolean  @default(false)
  allowedRoleNames     String[] // Systemrollen, die diese Priorität setzen dürfen (leer = alle mit ticket.change_priority)
  notifyRoleIds        String[] // Discord-Rollen, die bei dieser Priorität benachrichtigt werden
  /// SLA-Zielzeiten in Minuten (leer = keine Frist)
  firstResponseMinutes Int?
  resolutionMinutes    Int?
}

model TicketCloseReason {
  id       String @id @default(uuid()) @db.Uuid
  text     String
  position Int    @default(0)
}

/**
 * Support-Ticket (nicht zu verwechseln mit `Ticket` = Strafzettel).
 */
model SupportTicket {
  id                    String    @id @default(uuid()) @db.Uuid
  number                Int       @unique @default(autoincrement())
  categoryId            String    @db.Uuid
  panelId               String?   @db.Uuid
  guildId               String
  channelId             String?   @unique
  controlMessageId      String?
  name                  String
  creatorId             String // Discord-ID
  creatorName           String
  creatorUserId         String?   @db.Uuid
  statusId              String    @db.Uuid
  priorityId            String?   @db.Uuid
  claimers              String[] // Discord-IDs; erster = Hauptbearbeiter (PRIMARY)
  answers               Json      @default("[]")
  questionIndex         Int       @default(0)
  locked                Boolean   @default(false)
  closeReason           String?
  closedById            String?
  closedByName          String?
  closedAt              DateTime?
  firstResponseAt       DateTime?
  lastActivityAt        DateTime  @default(now())
  warnedAt              DateTime?
  staffAlertedAt        DateTime?
  closeRequestedAt      DateTime?
  deleteAt              DateTime?
  deletedAt             DateTime?
  escalatedAt           DateTime?
  departmentId          String?   @db.Uuid
  /// Betreff (aus dem Formular) und Formular-Version beim Einreichen
  subject               String?
  formVersion           Int?
  /// Idempotenz: Discord-Interaktion bzw. Formular-Entwurf, aus dem das Ticket entstand
  openKey               String?   @unique
  /// Wartezeit auf den Nutzer (SLA ruht): seit wann und bisher insgesamt
  waitingSince          DateTime?
  waitingSeconds        Int       @default(0)
  firstResponseDueAt    DateTime?
  resolveDueAt          DateTime?
  slaFirstWarnedAt      DateTime?
  slaResolveWarnedAt    DateTime?
  slaEscalatedAt        DateTime?
  unassignedEscalatedAt DateTime?
  resolvedAt            DateTime?
  archivedAt            DateTime?
  userMessageNotifiedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([departmentId])
  @@index([closedAt])
  @@index([creatorId, categoryId])
  @@index([statusId])
  @@index([createdAt])
}

/**
 * Zusätzlicher Zugriff im Ticket (Benutzer oder Rolle), optional befristet.
 */
model TicketAccess {
  id        String    @id @default(uuid()) @db.Uuid
  ticketId  String    @db.Uuid
  targetId  String
  kind      String // USER | ROLE
  expiresAt DateTime?
  addedById String?
  createdAt DateTime  @default(now())

  @@unique([ticketId, targetId])
}

model TicketMessage {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  discordId    String?  @unique
  authorId     String
  authorName   String
  authorAvatar String?
  isStaff      Boolean  @default(false)
  isBot        Boolean  @default(false)
  content      String   @default("")
  attachments  Json     @default("[]") // [{name, size, contentType, storageKey?, url}]
  embeds       Json     @default("[]")
  createdAt    DateTime @default(now())

  @@index([ticketId, createdAt])
}

/**
 * Interne Notizen – nur für berechtigte Mitarbeiter, nie für den Ersteller.
 */
model TicketNote {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  authorId     String? // Discord-ID
  authorUserId String?  @db.Uuid
  authorName   String
  text         String
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model TicketLog {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  action    String
  actorId   String? // Discord-ID
  actorName String?
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketTranscript {
  id            String    @id @default(uuid()) @db.Uuid
  ticketId      String    @db.Uuid
  ticketNumber  Int
  categoryName  String
  creatorId     String
  creatorName   String
  claimers      String[]
  statusName    String
  html          String    @default("")
  sizeBytes     Int       @default(0)
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  /// Version je Ticket (1, 2, …) – neue Erzeugung = neue Version, alte bleiben erhalten
  version       Int       @default(1)
  /// PENDING | RUNNING | DONE | FAILED (Hintergrund-Erstellung mit Wiederholungen)
  status        String    @default("DONE")
  trigger       String    @default("manual")
  /// verhindert doppelte Aufträge (z. B. derselbe Abschluss zweimal gemeldet)
  jobKey        String?   @unique
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  completedAt   DateTime?
  /// Text-Export und strukturierte Daten (JSON-Export) derselben Version, SHA-256 der Daten
  text          String    @default("")
  data          Json?
  sha256        String?
  /// wohin nach der Erstellung gesendet wird (Kanäle, DM)
  notify        Json      @default("{}")

  @@unique([ticketId, version])
  @@index([status, nextAttemptAt])
  @@index([ticketId])
  @@index([createdAt])
}

model TicketRating {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @unique @db.Uuid
  categoryId String   @db.Uuid
  creatorId  String
  staffIds   String[]
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())
}

/// Funk-Codes (z. B. „10-4 = Verstanden“) – je Discord-Server oder für alle Server (guildId null).
model RadioCode {
  id          String   @id @default(uuid()) @db.Uuid
  guildId     String?
  code        String
  meaning     String
  category    String?
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([guildId, code])
  @@index([guildId, position])
}

// ───────────── ER:LC-Integration & CAD ─────────────

/// Verbundener ER:LC-Privatserver. Der Server-Key liegt nur verschlüsselt hier (AES-256-GCM) und verlässt das Backend nie.
model ErlcServer {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  /// Optionale eigene Kennung (z. B. Join-Key) zur Anzeige
  serverRef        String?
  description      String?
  logoUrl          String?
  /// zugehöriger Discord-Server
  guildId          String?
  active           Boolean              @default(true)
  keyCipher        String
  pollSeconds      Int                  @default(15)
  /// Erlaubte Funktionen: players, staff, queue, vehicles, emergencyCalls, modCalls, joinLogs, killLogs, commandLogs, commands, webhook
  features         String[]             @default([])
  webhookEnabled   Boolean              @default(false)
  /// Geheimer Teil der Webhook-Adresse (bindet signierte PRC-Zustellungen an genau diesen Server)
  webhookToken     String               @default(dbgenerated("md5(((random())::text || (clock_timestamp())::text))"))
  /// API-Einstellungen (z. B. kritische/gesperrte Befehle, Timeout)
  settings         Json?
  status           String               @default("UNKNOWN") // CONNECTED | LIMITED | OFFLINE | ERROR | UNKNOWN | DISABLED
  lastSyncAt       DateTime?
  lastError        String?
  lastErrorAt      DateTime?
  latencyMs        Int?
  rateLimit        Json?
  /// Letzter erfolgreicher Datenstand (ohne Zugangsdaten) – bleibt bei API-Ausfall sichtbar
  snapshot         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  /// Letzter erfolgreicher Fahndungsabgleich (Spielerliste ↔ aktive Fahndungen) und letzter Fehler dabei
  wantedCheckAt    DateTime?
  wantedCheckError String?
  calls            ErlcEmergencyCall[]
  commands         ErlcCommandLog[]
  liveVehicles     ErlcLiveVehicle[]
  presence         ErlcPlayerPresence[]
  wantedHits       ErlcWantedHit[]
}

/// Wer gerade auf einem ER:LC-Server ist (aus dem Vergleich der Spielerlisten). Eine Zeile = eine Sitzung:
/// verlässt der Spieler den Server (oder zeigen die Join-Logs einen neuen Beitritt), beginnt eine neue Sitzung mit neuer ID.
/// Bleibt bei API-Ausfällen und Neustarts erhalten, damit derselbe Aufenthalt nicht erneut als Beitritt zählt.
model ErlcPlayerPresence {
  id           String     @id @default(uuid()) @db.Uuid
  serverId     String     @db.Uuid
  server       ErlcServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// „id:<Roblox-ID>“ bzw. „name:<name klein>“, falls die API keine ID liefert
  playerKey    String
  playerName   String
  robloxUserId String?
  joinedAt     DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())

  @@unique([serverId, playerKey])
}

/// Fahndungstreffer: ein Spieler auf dem ER:LC-Server passt zu einer aktiven Fahndung. Dauerhafte Historie (wird nie automatisch gelöscht).
/// Je Sitzung und Fahndung höchstens ein Eintrag. Bestätigt („identified“) nur bei exakt gleicher Roblox-ID oder nach manueller Prüfung.
model ErlcWantedHit {
  id               String        @id @default(uuid()) @db.Uuid
  /// Discord-Server des ER:LC-Servers (Trennung der Server im Dashboard)
  guildId          String?
  erlcServerId     String?       @db.Uuid
  erlcServer       ErlcServer?   @relation(fields: [erlcServerId], references: [id], onDelete: SetNull)
  serverName       String
  wantedId         String?       @db.Uuid
  wanted           WantedRecord? @relation(fields: [wantedId], references: [id], onDelete: SetNull)
  /// Stand der Fahndung bei der Erkennung (bleibt lesbar, auch wenn sich die Fahndung ändert)
  wantedNumber     String?
  wantedReason     String
  wantedPriority   String
  personId         String?       @db.Uuid
  /// Sitzung (ErlcPlayerPresence.id) – verhindert doppelte Treffer für denselben Aufenthalt
  sessionId        String        @db.Uuid
  sessionStartedAt DateTime
  playerName       String
  /// Roblox-ID laut ER:LC-API (fehlt, wenn die API keine liefert)
  robloxUserId     String?
  /// ROBLOX_ID | NAME | ALIAS | NAME_ID_MISMATCH
  matchType        String
  /// true nur bei exakter Roblox-ID oder manueller Bestätigung
  identified       Boolean       @default(false)
  /// NEW | REVIEW_REQUIRED | ACKNOWLEDGED | CONFIRMED | REJECTED
  reviewStatus     String
  reviewedById     String?       @db.Uuid
  reviewedAt       DateTime?
  reviewNote       String?
  /// QUEUED (Discord-Ausgang) | NOT_CONFIGURED (kein Kanal) | FAILED (konnte nicht eingereiht werden)
  notifyStatus     String        @default("NOT_CONFIGURED")
  outboxId         String?       @db.Uuid
  detectedAt       DateTime      @default(now())

  @@unique([sessionId, wantedId])
  @@index([guildId, detectedAt])
  @@index([wantedId])
  @@index([reviewStatus])
}

/// Notruf aus ER:LC (API oder Webhook). Verknüpfung mit einem CAD-Einsatz über incidentId.
model ErlcEmergencyCall {
  id                 String     @id @default(uuid()) @db.Uuid
  serverId           String     @db.Uuid
  callNumber         Int
  team               String?
  callerRobloxId     String?
  callerName         String?
  description        String?
  positionDescriptor String?
  mapX               Float?
  mapZ               Float?
  startedAt          DateTime
  status             String     @default("OPEN") // OPEN | CLAIMED | CLOSED
  claimedById        String?    @db.Uuid
  incidentId         String?    @db.Uuid
  source             String     @default("API") // API | WEBHOOK
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  server             ErlcServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, callNumber, startedAt])
  @@index([status, startedAt])
}

/// Protokoll des Command Centers (jeder ausgeführte ER:LC-Befehl).
model ErlcCommandLog {
  id        String     @id @default(uuid()) @db.Uuid
  serverId  String     @db.Uuid
  userId    String?    @db.Uuid
  discordId String?
  command   String
  critical  Boolean    @default(false)
  ok        Boolean
  result    String?
  error     String?
  createdAt DateTime   @default(now())
  server    ErlcServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

/// Eigene Kartenobjekte: POI (Punkt) oder Zone (Polygon). Koordinaten in ER:LC-Spielkoordinaten (unabhängig vom Kartenbild).
model CadMapObject {
  id           String   @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId     String?  @db.Uuid
  kind         String // POI | ZONE
  name         String
  description  String?
  category     String?
  /// Layer-Schlüssel (z. B. pois, zones, restricted oder eigener Layer)
  layer        String
  icon         String?
  color        String?
  x            Float?
  z            Float?
  points       Json?
  /// sichtbar für alle (leer) oder nur für diese Discord-Rollen
  roleIds      String[] @default([])
  incidentType String?
  autoAction   String?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([layer])
  @@index([serverId])
}

/// Chronik eines Einsatzes: Funkmeldungen, Statuswechsel, Zuweisungen, Notizen, Notruf-Verknüpfungen.
model CadIncidentLog {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  kind       String // RADIO | STATUS | ASSIGN | NOTE | CALL | CREATED
  text       String
  unitId     String?  @db.Uuid
  authorId   String?  @db.Uuid
  guildId    String?
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

/// Funkmeldung (Funk-Integration). Mit incidentId landet sie zusätzlich in der Einsatzchronik.
model CadRadioMessage {
  id         String   @id @default(uuid()) @db.Uuid
  callsign   String?
  unitId     String?  @db.Uuid
  incidentId String?  @db.Uuid
  text       String
  authorId   String?  @db.Uuid
  discordId  String?
  guildId    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Zuordnung Discord ↔ Roblox ↔ ER:LC ↔ Team ↔ Einheit, plus Funk-Benutzerdaten (Zello, Funkrufname, Abteilung, Rang).
model CadMember {
  id          String   @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId    String?  @db.Uuid
  userId      String?  @db.Uuid
  discordId   String?
  discordName String?
  robloxName  String?
  robloxId    String?
  erlcName    String?
  team        String?
  unitId      String?  @db.Uuid
  zelloName   String?
  callsign    String?
  department  String?
  rank        String?
  /// zusätzliche, im Dashboard konfigurierte Felder
  extra       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serverId, userId])
  @@unique([serverId, discordId])
  @@index([erlcName])
}

/// Verbindung zwischen zwei Discord-Servern (z. B. Leitstelle ↔ SEK/K9): welche Daten/Aktionen erlaubt sind.
model CadServerLink {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  sourceGuildId String
  targetGuildId String
  active        Boolean  @default(true)
  /// Datenarten, die die Quelle an das Ziel senden darf (incidents, incident_status, unit_requests, calls, announcements)
  sendTypes     String[] @default([])
  /// Aktionen, die das Ziel zurück an die Quelle ausführen darf (status_report, radio, view_incidents)
  allowActions  String[] @default([])
  /// Rollen auf dem Ziel-Server, die diese Aktionen ausführen dürfen (leer = alle mit passendem cad-Recht)
  roleIds       String[] @default([])
  /// Zielkanäle je Datenart: { "incidents": ["<channelId>"], ... }
  channels      Json?
  notify        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([sourceGuildId, targetGuildId])
}

// ───────────── Datensatz-Sperre beim Bearbeiten ─────────────

/// Wer gerade einen Datensatz bearbeitet. Läuft ohne Lebenszeichen nach kurzer Zeit ab.
model EditLock {
  entityType String
  entityId   String   @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@id([entityType, entityId])
  @@index([userId])
}

// ───────────── Studio-Workflows ─────────────

/// „Wenn <Audit-Ereignis> (und Bedingungen) → Aktionen“. Wirkt nur auf Ereignisse ab `activeSince`.
model Workflow {
  id          String        @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId    String?       @db.Uuid
  name        String
  enabled     Boolean       @default(true)
  trigger     String
  conditions  Json          @default("[]")
  actions     Json          @default("[]")
  activeSince DateTime      @default(now())
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        WorkflowRun[]

  @@index([serverId])
}

/// Jede Ausführung (einmal je Workflow und Audit-Eintrag).
model WorkflowRun {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  auditId    String   @db.Uuid
  action     String
  entityId   String?
  ok         Boolean  @default(true)
  error      String?
  createdAt  DateTime @default(now())

  @@unique([workflowId, auditId])
  @@index([workflowId, createdAt])
}

/// Sprach-Support: ein Fall entsteht, wenn jemand einen Warteraum betritt (Räume: SystemSetting `voice-support.rooms`).
model VoiceSupportCase {
  id              String    @id @default(uuid()) @db.Uuid
  number          String    @unique
  roomId          String
  roomName        String
  guildId         String
  userId          String // Discord-ID der hilfesuchenden Person
  userName        String
  status          String    @default("WAITING") // WAITING | CLAIMED | DECLINED | ABANDONED | CLOSED
  claimedById     String?
  claimedByName   String?
  claimedAt       DateTime?
  closedById      String?
  closedByName    String?
  closedAt        DateTime?
  closeReason     String?
  channelId       String? // Sprachkanal des Falls
  createdChannel  Boolean   @default(false) // vom Bot angelegt → wird beim Schließen gelöscht
  notifyChannelId String?
  notifyMessageId String?
  threadId        String?
  messages        Int       @default(0)
  rating          Int?
  createdAt       DateTime  @default(now())

  @@index([guildId, status])
  @@index([userId, status])
  @@index([channelId])
}

/// Roblox-Verifizierung (wie RoVer): Discord-Konto ↔ Roblox-Konto, gilt auf allen Servern.
model RobloxLink {
  discordId   String   @id
  discordName String?
  robloxId    String
  robloxName  String
  displayName String
  verifiedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([robloxId])
  @@index([robloxName])
}

/// Laufende Verifizierung: Code, der ins Roblox-Profil („Über mich“) muss.
model RobloxVerifyCode {
  discordId   String   @id
  robloxId    String
  robloxName  String
  displayName String
  code        String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

/// „Mit Roblox anmelden“ (OAuth): offener Vorgang, gehört zu einem Discord-Mitglied (einmal verwendbar, 10 Minuten gültig).
model RobloxOAuthState {
  state       String   @id
  discordId   String
  discordName String?
  guildId     String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([discordId])
}

// ───────────── Formular-Panels (Button → Formular → Nachricht) ─────────────

/// Eine Einsendung über ein Formular-Panel (z. B. Zello-/Roblox-Daten); `messageId`: wo der Bot das Ergebnis gepostet hat.
model PanelSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  panelId   String   @db.Uuid
  guildId   String?
  discordId String
  userName  String
  values    Json
  channelId String?
  messageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([panelId, discordId])
  @@index([panelId, createdAt])
}

// ───────────── Tages-/Wochenberichte (Vorlagen im Dashboard) ─────────────

/// Ausgefüllter Bericht nach einer Vorlage (Dashboard oder Discord). `channelId`/`messageId`: Nachricht in Discord, wird bei Änderungen bearbeitet.
model DutyReport {
  id           String    @id @default(uuid()) @db.Uuid
  number       String    @unique
  templateId   String    @db.Uuid
  templateName String
  period       String // DAILY | WEEKLY | FREE
  periodStart  DateTime
  authorId     String    @db.Uuid
  values       Json
  status       String    @default("SUBMITTED") // SUBMITTED | REVIEWED | RETURNED (zur Nachbesserung)
  source       String    @default("WEB") // WEB | DISCORD
  guildId      String?
  reviewedById String?   @db.Uuid
  reviewedAt   DateTime?
  /// Anmerkung der Leitung (bei „Geprüft“ optional, bei „Zur Nachbesserung“ Pflicht)
  reviewNote   String?
  editedById   String?   @db.Uuid
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  author       User      @relation("DutyReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([templateId, periodStart])
  @@index([authorId, createdAt])
}

// ───────────── Personal: Ränge, Anträge, Ausbildung, Prüfungen, Meldungen, Abstimmungen ─────────────

/// Rang (frei anlegbar, Reihenfolge = position; kleiner = höher). Personalakten speichern den Rangnamen.
model HrRank {
  id               String   @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId         String?  @db.Uuid
  name             String
  position         Int      @default(0)
  description      String?
  icon             String?
  color            String   @default("#64748b")
  /// Discord-Rollen dieses Rangs (auf allen Servern)
  discordRoleIds   String[] @default([])
  /// Dashboard-Rollen, die mit dem Rang vergeben werden (optional)
  dashboardRoleIds String[] @default([])
  /// erlaubte Beförderung nach (Rang-IDs; leer = nächsthöherer)
  nextRankIds      String[] @default([])
  /// Beförderung IN diesen Rang dürfen nur Personen mit einem dieser Ränge genehmigen (leer = jeder mit promotion.approve)
  approverRankIds  String[] @default([])
  /// Voraussetzungen [{ id, type, label, value, ref }]
  requirements     Json     @default("[]")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([serverId, name])
}

/// Antrag: Beförderung oder Versetzung, mit konfigurierbaren Genehmigungsstufen.
model HrRequest {
  id           String    @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId     String?   @db.Uuid
  number       String    @unique
  kind         String // PROMOTION | TRANSFER
  personnelId  String    @db.Uuid
  status       String    @default("OPEN") // OPEN | IN_REVIEW | APPROVED | REJECTED | DEFERRED | EXECUTED | CANCELLED
  fromValue    String?
  toValue      String
  reason       String
  achievements String?
  internalNote String?
  attachments  String[]  @default([])
  requesterId  String    @db.Uuid
  /// [{ userId, name, stage, decision: APPROVE|REJECT|REVIEW|DEFER, comment, at }]
  approvals    Json      @default("[]")
  decidedAt    DateTime?
  executedById String?   @db.Uuid
  executedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  version      Int       @default(1)
  personnel    Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@index([kind, status])
  @@index([personnelId])
  @@index([serverId])
}

model HrTraining {
  id             String               @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId       String?              @db.Uuid
  name           String
  description    String?
  requirements   String?
  instructorIds  String[]             @default([])
  duration       String?
  active         Boolean              @default(true)
  examRequired   Boolean              @default(false)
  examId         String?              @db.Uuid
  certificate    Boolean              @default(true)
  audience       String?
  requiredRoleId String?
  /// Gültigkeit in Tagen (leer = unbegrenzt)
  validDays      Int?
  /// Module der Ausbildung (Checkliste, in Reihenfolge); leer = Fortschritt in Prozent von Hand
  modules        String[]             @default([])
  position       Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  progress       HrTrainingProgress[]

  @@index([serverId])
}

model HrTrainingProgress {
  id            String     @id @default(uuid()) @db.Uuid
  trainingId    String     @db.Uuid
  personnelId   String     @db.Uuid
  status        String     @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | PASSED | FAILED | ABORTED | EXPIRED
  progress      Int        @default(0)
  /// abgehakte Module (Namen aus HrTraining.modules)
  doneModules   String[]   @default([])
  examinerId    String?    @db.Uuid
  note          String?
  startedAt     DateTime?
  completedAt   DateTime?
  expiresAt     DateTime?
  certificateNo String?    @unique
  updatedAt     DateTime   @updatedAt
  training      HrTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  personnel     Personnel  @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@unique([trainingId, personnelId])
}

model HrExam {
  id               String          @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId         String?         @db.Uuid
  title            String
  description      String?
  /// Hinweise auf der Startseite vor Beginn
  instructions     String?
  category         String?
  /// [{ id, type: SINGLE|MULTI|YESNO|TEXT|NUMBER|ORDER|MATCH|GAP, text, options[], matches[], correct[], points, partial, tolerance, explanation, image }]
  questions        Json            @default("[]")
  /// zufällig gezogene Fragen je Versuch (0 = alle)
  questionCount    Int             @default(0)
  passPercent      Int             @default(70)
  timeLimitMin     Int?
  maxAttempts      Int             @default(3)
  retryHours       Int             @default(24)
  autoGrade        Boolean         @default(true)
  showResult       Boolean         @default(true)
  /// Einsicht nach der Bewertung: NONE | ANSWERS | SOLUTIONS
  reviewMode       String          @default("ANSWERS")
  /// PAGED (eine Frage pro Seite) | LIST
  layout           String          @default("PAGED")
  shuffleQuestions Boolean         @default(false)
  shuffleOptions   Boolean         @default(false)
  examinerIds      String[]        @default([])
  /// Dashboard-Rollen (leer = alle mit exam.view)
  audienceRoleIds  String[]        @default([])
  trainingId       String?         @db.Uuid
  /// muss vorher bestanden sein
  requiredExamId   String?         @db.Uuid
  availableFrom    DateTime?
  availableUntil   DateTime?
  notifyExaminers  Boolean         @default(true)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  attempts         HrExamAttempt[]

  @@index([serverId])
}

model HrExamAttempt {
  id             String    @id @default(uuid()) @db.Uuid
  examId         String    @db.Uuid
  personnelId    String    @db.Uuid
  /// Fragen-IDs dieses Versuchs (bei Zufallsauswahl)
  questionIds    String[]  @default([])
  answers        Json      @default("{}")
  status         String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | GRADED | VOIDED
  /// Fragen zum Zeitpunkt des Starts (spätere Änderungen an der Prüfung verändern alte Versuche nicht)
  snapshot       Json?
  /// gemischte Reihenfolge je Frage: { o: { [frageId]: number[] }, m: { [frageId]: number[] } }
  shuffle        Json      @default("{}")
  /// vom Teilnehmer markierte Fragen
  flagged        String[]  @default([])
  /// erreichte Punkte je Frage (nach der Bewertung)
  questionScores Json?
  voidReason     String?
  voidedById     String?   @db.Uuid
  voidedAt       DateTime?
  score          Float?
  maxScore       Float?
  passed         Boolean?
  gradedById     String?   @db.Uuid
  gradedAt       DateTime?
  feedback       String?
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  exam           HrExam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  personnel      Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@index([examId, personnelId])
  @@index([status])
}

// ───────────── Dienstnummern ─────────────

/// Nummernkreis, z. B. 1000–1999 oder LS-001–LS-999.
model ServiceNumberRange {
  id         String          @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId   String?         @db.Uuid
  name       String
  prefix     String          @default("")
  suffix     String          @default("")
  start      Int
  end        Int
  /// Mindestlänge der Zahl (mit führenden Nullen), 0 = ohne
  padLength  Int             @default(0)
  /// LOWEST_FREE (kleinste freie) | SEQUENTIAL (immer weiter hochzählen)
  order      String          @default("LOWEST_FREE")
  autoAssign Boolean         @default(true)
  manual     Boolean         @default(true)
  /// frei gewordene Nummern wieder vergeben
  reuse      Boolean         @default(true)
  /// was mit der alten Nummer bei Änderung/Austritt passiert: FREE | FORMER | BLOCKED
  releaseAs  String          @default("FORMER")
  department String?
  active     Boolean         @default(true)
  position   Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  numbers    ServiceNumber[]

  @@index([serverId])
}

model ServiceNumber {
  id          String             @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId    String?            @db.Uuid
  rangeId     String             @db.Uuid
  value       Int
  display     String
  status      String             @default("FREE") // ACTIVE | RESERVED | FREE | BLOCKED | FORMER
  userId      String?            @db.Uuid
  personnelId String?            @db.Uuid
  reservedAt  DateTime?
  assignedAt  DateTime?
  note        String?
  updatedAt   DateTime           @updatedAt
  range       ServiceNumberRange @relation(fields: [rangeId], references: [id], onDelete: Restrict)

  @@unique([rangeId, value])
  @@unique([serverId, display])
  @@index([status])
  @@index([userId])
}

/// Historie je Dienstnummer und Person (Vergabe, Änderung, Freigabe, Sperre …).
model ServiceNumberEvent {
  id          String   @id @default(uuid()) @db.Uuid
  display     String
  oldDisplay  String?
  userId      String?  @db.Uuid
  personnelId String?  @db.Uuid
  action      String // ASSIGNED_AUTO | ASSIGNED_MANUAL | CHANGED | RELEASED | BLOCKED | UNBLOCKED | RESERVED | FORMER | PENDING
  reason      String?
  actorId     String?  @db.Uuid
  approverId  String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([display, createdAt])
  @@index([personnelId, createdAt])
}

/// Einstellung nach angenommener Bewerbung, die noch auf eine Dienstnummer wartet („⚠️ Dienstnummer ausstehend“).
model HireQueue {
  id            String   @id @default(uuid()) @db.Uuid
  /// Bereich des Discord-Servers (Akten-Bereich, siehe server-scope.ts); null = gemeinsamer Altbestand
  serverId      String?  @db.Uuid
  applicationId String   @unique
  kind          String
  userId        String   @db.Uuid
  discordId     String?
  reason        String
  status        String   @default("PENDING") // PENDING | DONE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([serverId])
}

/// Discord-Server-Backup (wie Xenon): Rollen, Kanäle, Rechte, Servereinstellungen. Der Bot liest bzw. stellt wieder her.
model DiscordBackup {
  id            String    @id @default(uuid()) @db.Uuid
  guildId       String
  guildName     String    @default("")
  name          String
  auto          Boolean   @default(false)
  /// PENDING (Bot sammelt) | READY | FAILED
  status        String    @default("PENDING")
  data          Json?
  /// { roles, channels, categories }
  stats         Json?
  error         String?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  restoredAt    DateTime?
  restoreResult Json?

  @@index([guildId, createdAt])
}

/// Ausbildungstermin: Ankündigung mit Anmeldung (Discord-Button + Dashboard), Auswertung (erschienen/bestanden/Dauer), Beförderung bei Bestehen.
model HrTrainingSession {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique
  trainingId     String?   @db.Uuid
  title          String
  startsAt       DateTime
  /// „Für den Rang“ (Anzeige)
  forRank        String?
  /// „Ungefähre Dauer“, z. B. „60–120 Minuten“
  duration       String?
  location       String?
  notes          String?
  instructorId   String?   @db.Uuid
  channelId      String?
  guildId        String?
  /// Rang, den Bestandene automatisch bekommen (leer = keine Beförderung)
  promoteRankId  String?   @db.Uuid
  maxSignups     Int?
  /// PLANNED | DONE | CANCELLED
  status         String    @default("PLANNED")
  /// [{ discordId, userId?, name, at }]
  signups        Json      @default("[]")
  /// Discord-IDs
  attended       String[]  @default([])
  passed         String[]  @default([])
  actualDuration String?
  evaluationNote String?
  evaluatedAt    DateTime?
  evaluatedById  String?   @db.Uuid
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([startsAt])
}

/// Schichtübergabe der Leitstelle: Stand bei Übergabe (offene Einsätze, eingesetzte Einheiten, offene Notrufe, letzte Statusänderungen) + Notizen; die nächste Schicht bestätigt.
model CadHandover {
  id               String    @id @default(uuid()) @db.Uuid
  guildId          String?
  createdById      String?   @db.Uuid
  notes            String
  /// eingefrorener Stand zum Zeitpunkt der Übergabe (vertrauliche Einsätze nur als Anzahl)
  snapshot         Json
  acknowledgedById String?   @db.Uuid
  acknowledgedAt   DateTime?
  ackNote          String?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
}

/// Dauerhafte Kennzahlen abgeschlossener Einsätze – bleiben für die Statistik, wenn der Einsatz selbst nach einem Tag gelöscht wird.
model CadIncidentStat {
  incidentId   String   @id @db.Uuid
  number       String
  type         String?
  priority     String
  status       String
  source       String
  guildId      String?
  dispatcherId String?  @db.Uuid
  createdAt    DateTime
  closedAt     DateTime
  /// beteiligte Einheiten (Rufnamen und Einheitentypen) über die ganze Dauer des Einsatzes
  units        String[] @default([])
  unitTypes    String[] @default([])

  @@index([closedAt])
  @@index([createdAt])
}

/// Polizeifahrzeug aus der ER:LC-API (nur gespawnte Fahrzeuge). API-Felder schreibt nur der Abgleich, interne Felder nur das Dashboard.
/// ER:LC liefert keine Fahrzeug-ID: `key` = Besitzer + Modell + Kennzeichen (+ #n bei mehreren gleichen → `uncertain`).
model ErlcLiveVehicle {
  id             String             @id @default(uuid()) @db.Uuid
  erlcServerId   String             @db.Uuid
  key            String
  // ---- aus der ER:LC-API ----
  name           String
  owner          String
  ownerRobloxId  String?
  ownerTeam      String?
  plate          String?
  texture        String?
  colorHex       String?
  colorName      String?
  /// „team“ = Besitzer im Team Police, „catalog“ = Modell steht im Polizei-Katalog (Besitzer gerade nicht im Spiel)
  policeReason   String
  uncertain      Boolean            @default(false)
  active         Boolean            @default(true)
  firstSeenAt    DateTime           @default(now())
  lastSeenAt     DateTime           @default(now())
  apiChangedAt   DateTime           @default(now())
  // ---- intern (CAD) ----
  unitId         String?            @db.Uuid
  internalStatus String             @default("UNASSIGNED")
  internalCode   String?
  notes          String?
  tags           String[]           @default([])
  version        Int                @default(1)
  updatedAt      DateTime           @updatedAt
  server         ErlcServer         @relation(fields: [erlcServerId], references: [id], onDelete: Cascade)
  events         ErlcVehicleEvent[]

  @@unique([erlcServerId, key])
  @@index([active])
  @@index([unitId])
}

/// Verlauf eines Live-Fahrzeugs: gespawnt, nicht mehr gemeldet, API-Daten geändert, interne Änderung, Einsatz dokumentiert.
model ErlcVehicleEvent {
  id         String          @id @default(uuid()) @db.Uuid
  vehicleId  String          @db.Uuid
  kind       String // SPAWNED | DESPAWNED | CHANGED | INTERNAL | INCIDENT
  text       String
  incidentId String?         @db.Uuid
  actorId    String?         @db.Uuid
  createdAt  DateTime        @default(now())
  vehicle    ErlcLiveVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
}

/// Gepflegter Katalog der Polizeifahrzeug-Modelle (getrennt von den gerade gespawnten Fahrzeugen).
model PoliceVehicleModel {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  erlcName     String   @unique
  category     String
  description  String?
  internalCode String?
  imageId      String?  @db.Uuid
  active       Boolean  @default(true)
  tags         String[] @default([])
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ───────────── Multi-Server: Server, Mitgliedschaften, Module, Verbindungen, Synchronisierung ─────────────

/// Registrierter Discord-Server (Mandant). Deaktivieren/Archivieren löscht nie Fachdaten.
model DiscordServer {
  id                 String                   @id @default(uuid()) @db.Uuid
  guildId            String                   @unique
  name               String
  /// ACTIVE | DISABLED | ERROR (Verbindungsfehler)
  status             String                   @default("ACTIVE")
  /// archiviert („gelöscht“) – Daten bleiben, Server ist nicht mehr wählbar
  archivedAt         DateTime?
  /// Rollen dieses Servers angelegt (Startrollen bzw. bei der Migration übernommene bisherige Rollen)
  rolesInitializedAt DateTime?
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  memberships        ServerMembership[]
  modules            ServerModuleSetting[]
  roleMappings       DiscordRoleMapping[]
  connections        ServerConnectionMember[]
}

/// Mitgliedschaft eines Benutzers auf einem Server. Nur MEMBER berechtigt zum Zugriff auf diesen Server.
model ServerMembership {
  id             String        @id @default(uuid()) @db.Uuid
  serverId       String        @db.Uuid
  userId         String        @db.Uuid
  /// MEMBER | LEFT | UNKNOWN
  status         String        @default("UNKNOWN")
  /// DISCORD (vom Bot/Discord geprüft) | MANUAL (vom Administrator für Konten ohne Discord)
  source         String        @default("DISCORD")
  /// Discord-Rollen des Mitglieds auf diesem Server (letzter Abgleich)
  discordRoleIds String[]      @default([])
  lastVerifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  server         DiscordServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
}

/// Modul-Katalog (aus dem Code gepflegt: packages/shared/src/modules.ts)
model AppModule {
  key         String                @id
  name        String
  description String?
  isSystem    Boolean               @default(false)
  dependsOn   String[]              @default([])
  settings    ServerModuleSetting[]
}

/// Modul je Server: an/aus + validierte Einstellungen. Ohne Zeile gilt der Standard (an). `version` für optimistisches Sperren.
model ServerModuleSetting {
  id          String        @id @default(uuid()) @db.Uuid
  serverId    String        @db.Uuid
  moduleKey   String
  enabled     Boolean       @default(true)
  settings    Json          @default("{}")
  version     Int           @default(1)
  updatedById String?       @db.Uuid
  updatedAt   DateTime      @updatedAt
  server      DiscordServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  module      AppModule     @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@unique([serverId, moduleKey])
}

/// Discord-Rolle (eines bestimmten Servers) → interne Rolle. Verleiht die interne Rolle nur auf diesem Server.
model DiscordRoleMapping {
  id            String        @id @default(uuid()) @db.Uuid
  serverId      String        @db.Uuid
  discordRoleId String
  roleId        String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  server        DiscordServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  role          Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([serverId, discordRoleId, roleId])
  @@index([roleId])
}

/// Verbindung mehrerer Server. Eine Verbindung allein erlaubt keinen Datenaustausch – dafür braucht es Datenfreigaben.
model ServerConnection {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String
  /// ACTIVE | DISABLED
  status      String                   @default("ACTIVE")
  version     Int                      @default(1)
  createdById String?                  @db.Uuid
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  members     ServerConnectionMember[]
  policies    ConnectionDataPolicy[]
  events      SyncEvent[]
}

model ServerConnectionMember {
  id           String                 @id @default(uuid()) @db.Uuid
  connectionId String                 @db.Uuid
  serverId     String                 @db.Uuid
  createdAt    DateTime               @default(now())
  connection   ServerConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  server       DiscordServer          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  asSource     ConnectionDataPolicy[] @relation("PolicySource")
  asTarget     ConnectionDataPolicy[] @relation("PolicyTarget")

  @@unique([connectionId, serverId])
  @@index([serverId])
}

/// Datenfreigabe zwischen zwei Mitgliedern einer Verbindung. Richtung: A_TO_B (Quelle→Ziel), B_TO_A, BIDIRECTIONAL, NONE.
/// Freigaben übertragen nur lesende Kopien – nie Bearbeitungsrechte.
model ConnectionDataPolicy {
  id             String                 @id @default(uuid()) @db.Uuid
  connectionId   String                 @db.Uuid
  sourceServerId String                 @db.Uuid
  targetServerId String                 @db.Uuid
  dataType       String
  direction      String                 @default("A_TO_B")
  enabled        Boolean                @default(true)
  settings       Json                   @default("{}")
  version        Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  connection     ServerConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  source         ServerConnectionMember @relation("PolicySource", fields: [connectionId, sourceServerId], references: [connectionId, serverId], onDelete: Cascade, map: "ConnectionDataPolicy_source_member_fkey")
  target         ServerConnectionMember @relation("PolicyTarget", fields: [connectionId, targetServerId], references: [connectionId, serverId], onDelete: Cascade, map: "ConnectionDataPolicy_target_member_fkey")

  @@unique([connectionId, sourceServerId, targetServerId, dataType])
}

/// Outbox der serverübergreifenden Synchronisierung. `idempotencyKey` verhindert doppelte Verarbeitung.
model SyncEvent {
  id             String           @id @default(uuid()) @db.Uuid
  connectionId   String           @db.Uuid
  policyId       String           @db.Uuid
  sourceServerId String           @db.Uuid
  targetServerId String           @db.Uuid
  dataType       String
  eventType      String
  sourceRecordId String
  sourceVersion  Int              @default(1)
  idempotencyKey String           @unique
  payload        Json
  /// PENDING | DONE | SKIPPED (veraltet/Konflikt) | FAILED (endgültig, manuell wiederholbar) | CANCELLED (Verbindung/Freigabe aus)
  status         String           @default("PENDING")
  attemptCount   Int              @default(0)
  nextAttemptAt  DateTime         @default(now())
  lastError      String?
  createdAt      DateTime         @default(now())
  processedAt    DateTime?
  connection     ServerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([connectionId, createdAt])
}

/// Nur lesend synchronisierte Kopie eines Datensatzes eines anderen Servers (Zielseite).
model SyncedRecord {
  id             String   @id @default(uuid()) @db.Uuid
  targetServerId String   @db.Uuid
  sourceServerId String   @db.Uuid
  connectionId   String   @db.Uuid
  dataType       String
  sourceRecordId String
  sourceVersion  Int
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([targetServerId, dataType, sourceRecordId])
  @@index([targetServerId, dataType, updatedAt])
}

// ───────────── Discord Message Builder ─────────────

/// Kategorien der Vorlagen (im Editor bearbeitbar).
model MessageBuilderCategory {
  id        String                   @id @default(uuid()) @db.Uuid
  /// Discord-Server (Message Builder je Server getrennt)
  guildId   String?
  name      String
  position  Int                      @default(0)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  documents MessageBuilderDocument[]

  @@unique([guildId, name])
}

/// Entwurf oder Vorlage: eine Gruppe aus mehreren Discord-Nachrichten (Inhalt siehe `mbDocumentDataSchema` in @enrp/shared).
model MessageBuilderDocument {
  id          String                  @id @default(uuid()) @db.Uuid
  /// Discord-Server (Message Builder je Server getrennt)
  guildId     String?
  /// DRAFT | TEMPLATE
  kind        String
  name        String
  categoryId  String?                 @db.Uuid
  data        Json
  /// zuletzt gewählter Kanal (Komfort beim Senden)
  channelId   String?
  /// optimistisches Sperren (Autosave aus mehreren Tabs)
  version     Int                     @default(1)
  createdById String?                 @db.Uuid
  updatedById String?                 @db.Uuid
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  /// gelöscht (nach Bestätigung) – bleibt als Archiv erhalten
  archivedAt  DateTime?
  category    MessageBuilderCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([kind, archivedAt, updatedAt])
  @@index([guildId])
}

/// Ein Versand (Historie): Gruppe von Nachrichten an einen Kanal über den Bot, einen Webhook oder als Test (ohne Discord).
model MessageBuilderSend {
  id            String                   @id @default(uuid()) @db.Uuid
  /// Discord-Server (Message Builder je Server getrennt)
  guildId       String?
  documentId    String?                  @db.Uuid
  documentName  String
  /// BOT | WEBHOOK | TEST
  mode          String
  channelId     String?
  channelName   String?
  webhookId     String?                  @db.Uuid
  /// QUEUED | SENDING | SENT | PARTIAL | FAILED | TEST
  status        String                   @default("QUEUED")
  error         String?
  createdById   String?                  @db.Uuid
  createdByName String
  createdAt     DateTime                 @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  items         MessageBuilderSendItem[]

  @@index([createdAt])
  @@index([status])
  @@index([guildId, createdAt])
}

/// Eine Nachricht eines Versands mit eigenem Status. `payload` (Discord-JSON) nur bis zum Versand, danach geleert.
model MessageBuilderSendItem {
  id        String             @id @default(uuid()) @db.Uuid
  sendId    String             @db.Uuid
  position  Int
  summary   String
  /// PENDING | SENT | FAILED | SKIPPED | TEST
  status    String             @default("PENDING")
  messageId String?
  error     String?
  payload   Json?
  sentAt    DateTime?
  send      MessageBuilderSend @relation(fields: [sendId], references: [id], onDelete: Cascade)

  @@unique([sendId, position])
}

/// Aktion eines interaktiven Buttons/Auswahlmenüs (custom_id `mb:<id>`). Beim Versand festgeschrieben – spätere Änderungen an der Vorlage ändern gesendete Buttons nicht.
model MessageBuilderAction {
  id          String   @id @default(uuid()) @db.Uuid
  /// Discord-Server (Message Builder je Server getrennt)
  guildId     String?
  sendId      String?  @db.Uuid
  /// button | select
  kind        String
  config      Json
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([sendId])
}

/// Optionaler Webhook (Versand mit eigenem Namen/Bild). Die URL enthält das Webhook-Token und liegt nur verschlüsselt vor.
model MessageBuilderWebhook {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  /// AES-256-GCM-verschlüsselte Webhook-URL
  secret      String
  /// öffentliche Discord-ID des Webhooks
  webhookId   String
  channelId   String?
  guildId     String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  @@index([guildId])
}
