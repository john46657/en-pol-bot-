{
  "name": "enrp-nexus",
  "private": true,
  "version": "0.1.0",
  "description": "ENRP NEXUS \u2014 Police CAD / MDT / Dispatch for Emergency Response: Liberty County",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @enrp/api prisma:generate",
    "db:migrate:dev": "pnpm --filter @enrp/api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @enrp/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @enrp/api db:seed",
    "e2e": "playwright test",
    "dev:all": "node scripts/dev.mjs",
    "demo": "node scripts/demo-data.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "argon2",
      "embedded-postgres",
      "@embedded-postgres/darwin-arm64"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
