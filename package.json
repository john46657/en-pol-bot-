{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS — Discord Operating System / All-in-One Discord Platform",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev-setup.mjs && turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "db:generate": "pnpm --filter @nexus/database prisma:generate",
    "db:migrate:dev": "pnpm --filter @nexus/database prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @nexus/database prisma:migrate:deploy",
    "db:push": "pnpm --filter @nexus/database prisma:push",
    "db:studio": "pnpm --filter @nexus/database prisma:studio",
    "prepare": "husky",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:setup": "node scripts/dev-setup.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.10",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.2",
      "js-yaml": ">=5.4.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma"
    ]
  }
}
