{
  "name": "@enrp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node -r @swc-node/register src/seed/run.ts",
    "dev:db": "tsx scripts/dev-db.mts"
  },
  "prisma": {
    "seed": "node -r @swc-node/register src/seed/run.ts"
  },
  "dependencies": {
    "@enrp/shared": "workspace:*",
    "@nestjs/common": "^11.2.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/platform-express": "^11.2.0",
    "@nestjs/platform-socket.io": "^11.2.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.12.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "unplugin-swc": "^1.5.5"
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/migrations"
  ]
}
